{"meta":{"id":"tt26245982","type":"movie","name":"Tardes de soledad","imdb_id":"tt26245982","description":"Retrato de una figura del toreo en activo, Andrés Roca Rey, que permite reflexionar sobre la experiencia íntima del torero, que asume el riesgo de enfrentarse al toro como un deber personal, por respeto a la tradición y como un desafío estético. Esto crea una forma de belleza efímera a través de la confrontación material y violenta entre la racionalidad humana y la brutalidad del animal.","poster":"https://btttr.cc/poster-q/imdb/poster-default/tt26245982.jpg?tag=none&lang=es-MX&rs=IM","background":"https://image.tmdb.org/t/p/original/eBNcp12gC6DQRERxutSoPIypkqh.jpg","genres":["Documental"],"releaseInfo":"2025","released":"2025-03-07T12:00:00.000Z","status":"Released","runtime":"125 min","imdbRating":"7.1","country":"Spain, Portugal, France","cast":["Andrés Roca Rey","Roberto Domínguez","Francisco Manuel \"Viruta\" Durán","Antonio Chacón","Paco Gómez","Manuel \"Larita\" Lara"],"director":["Albert Serra"],"writer":["Albert Serra"],"trailers":[{"source":"3CXJjQh4JsA","type":"Trailer","name":"Official Trailer [Subtitled]","ytId":"3CXJjQh4JsA","lang":"en"}],"trailerStreams":[{"ytId":"3CXJjQh4JsA","title":"Official Trailer [Subtitled]"}],"links":[{"name":"7.1","category":"imdb","url":"https://imdb.com/title/tt26245982"},{"name":"Documental","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/movie/top?genre=Documental"},{"name":"Andrés Roca Rey","category":"Cast","url":"stremio:///search?search=Andr%C3%A9s%20Roca%20Rey"},{"name":"Roberto Domínguez","category":"Cast","url":"stremio:///search?search=Roberto%20Dom%C3%ADnguez"},{"name":"Francisco Manuel \"Viruta\" Durán","category":"Cast","url":"stremio:///search?search=Francisco%20Manuel%20%22Viruta%22%20Dur%C3%A1n"},{"name":"Antonio Chacón","category":"Cast","url":"stremio:///search?search=Antonio%20Chac%C3%B3n"},{"name":"Paco Gómez","category":"Cast","url":"stremio:///sear