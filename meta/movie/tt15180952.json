{"meta":{"id":"tt15180952","type":"movie","name":"The Balcony Movie","imdb_id":"tt15180952","description":"Composed from the conversations that the director holds with people passing by in the street under his Warsaw apartment, each story in 'The Balcony Movie' is unique and deals with the way we try to cope with life as individuals. All together, they create a self-portrait of contemporary human life, and the passers-by present a composite picture of today's world.","poster":"https://btttr.cc/poster-q/imdb/poster-default/tt15180952.jpg?tag=none&lang=es-MX&rs=IM","background":"https://image.tmdb.org/t/p/original/55A6U9ywDkoV2GxezvbaMwBpeGT.jpg","genres":["Documental"],"releaseInfo":"2021","released":"2021-08-07T12:00:00.000Z","status":"Released","runtime":"100 min","imdbRating":"7.5","country":"Poland, Czech Republic","cast":["Paweł Łoziński"],"director":["Paweł Łoziński"],"writer":["Paweł Łoziński"],"trailers":[{"source":"AC_yQ6DviZ8","type":"Trailer","name":"Hot Docs 2022 Trailer: THE BALCONY MOVIE","ytId":"AC_yQ6DviZ8","lang":"en"}],"trailerStreams":[{"ytId":"AC_yQ6DviZ8","title":"Hot Docs 2022 Trailer: THE BALCONY MOVIE"}],"links":[{"name":"7.5","category":"imdb","url":"https://imdb.com/title/tt15180952"},{"name":"Documental","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/movie/top?genre=Documental"},{"name":"Paweł Łoziński","category":"Cast","url":"stremio:///search?search=Pawe%C5%82%20%C5%81ozi%C5%84ski"},{"name":"Paweł Łoziński","category":"Directors","url":"stremio:///search?search=Pawe%C5%82%20%C5%81ozi%C5%84ski"},{"name":"Paweł Łoziński","category":"Writers","url":"stremio:///search?search=Pawe%C5%82%20%C5%81ozi%C5%84ski"}],"app_extras":{"cast":[{"name":"Paweł Łoziński","character":"Self (voice)","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/17nDRhT3BP3PWlSXDyUMhmLExOV.jpg","tmdbId":1026297}],"directors":[{"name":"Paweł Łoziński","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/17nDRhT3BP3PW