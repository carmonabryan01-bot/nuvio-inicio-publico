64846},{"name":"Lee Chan-hee","character":"Ahn Seong-gyoo","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/83sfJRvOKNOgB9EevhpvGW2BK7Y.jpg","tmdbId":6542719},{"name":"김찬형","character":"Byeong-gil","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/xXJAj8KKnQNJ5b8Q6hYdPBvPs7W.jpg","tmdbId":3575092},{"name":"Justin Chon","character":"Chef Paulo","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/fGgdkJO7SAPHNo3siSyaYUpguyj.jpg","tmdbId":65225},{"name":"Bret Allan Lindquist","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/9K51gOdC3OU1SPmIiwvrgshOPQn.jpg","tmdbId":3796067},{"name":"이주미","character":"Myeong-hee","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/spEyrTxWVFlGc3cgkAfL6oZW69i.jpg","tmdbId":4696096},{"name":"Chae Ja-woon","character":"Child zombie","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/uqA2LWTHPAZZXMieAgdVHfO9BCr.jpg","tmdbId":6542752},{"name":"Lee Dan","character":"Peep zombie","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/nbC0z89SJ6kB0jE0lSo2EwZN3nI.jpg","tmdbId":6542759},{"name":"Park Jae-gwan","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/xA10mFmZEgzY5E5KO2CfrlUQpF1.jpg","tmdbId":6542780},{"name":"Shin Dong-ho","character":"Zombie soldier","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/kPvC1Elne6sh6neBFKkWpM9AABc.jpg","tmdbId":6531141},{"name":"한동원","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/ivAzeYw2onTYMDPrAbEN8xJZLXZ.jpg","tmdbId":5143166},{"name":"차유주","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/9eC3TXIc73YtNlznWLz0iwIpxKm.jpg","tmdbId":5183627},{"name":"김단비","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/zKa9nxQQux4TT94oWKTSLhxnJNq.jpg","tmdbId":6292241},{"name":"이유주","character":"Eden Hotel little girl","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/fhcTjqgsuVBKpLSgmyNvdWphsQl.jpg","tmdbId":1727064}],"directors":[{"name":"윤성현","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/6p012oojl8y0OxvJPM2EUUnN7Op.jpg","tmdbId":531737}],"writers":[{"name":"한진원","character":"한진원","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/j9qXEqOsZENCqni8WzGH6pXginJ.jpg","tmdbId":2320121},{"name":"Ji Ho-jin","character":"Ji Ho-jin","photo":null,"tmdbId":2160626}],"seasonPosters":["https://image.tmdb.org/t/p/w500/ilBndopP8kfpmhmlWDoR6xs5fKa.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt32199328:1:1","season":1,"episode":1,"title":"Episodio 1","overview":"Young-joo rompe con su novio, Jae-yoon. Acepta la ruptura con un sincero mensaje de voz. Al escuchar esto, Young-joo se dirige a su lugar de trabajo, pero se encuentra con un incidente inesperado en su camino hacia allí.","thumbnail":"https://image.tmdb.org/t/p/w780/exqPH5aC63GLH5c5WIhnBHLVnil.jpg","released":"2025-02-07T12:00:00.000Z","runtime":"59 min"},{"id":"tt32199328:1:2","season":1,"episode":2,"title":"Episodio 2","overview":"Jae-yoon e In-ho encuentran un avión que se estrella en el corazón de Seúl. Young-joo y Jin-wook se enfrentan a zombis y forman equipo con Tae-shik. Juntos, comienzan su lucha por la supervivencia.","thumbnail":"https://image.tmdb.org/t/p/w780/qdocJsG4uAjFZygg8QFylMdG9y5.jpg","released":"2025-02-07T12:00:00.000Z","runtime":"49 min"},{"id":"tt32199328:1:3","season":1,"episode":3,"title":"Episodio 3","overview":"Soo-Jeong and chef Jung from the Eden Hotel, Jae-Yoon, and In-Ho manage to return to the military unit. The find out the base they thought was safe begins to face the threat of zombies. Young-Joo sees the text messages sent by Jae-Yoon.","thumbnail":"https://image.tmdb.org/t/p/w780/ve4YUyhKTG3iS32Mo2VwHFIt1VY.jpg","released":"2025-02-14T12:00:00.000Z","runtime":"51 min"},{"id":"tt32199328:1:4","season":1,"episode":4,"title":"Episodio 4","overview":"In the midst of the zombie crisis, Jae-yoon and Young-joo reminisce about their happy past and long for each other even more. Meanwhile, Jae-yoon and his squad mourn the loss of their comrades but find relief in the news of a supply helicopter's arrival. Young-joo’s group encounters Tripeater, who has been bitten by a zombie but has not yet turned.","thumbnail":"https://image.tmdb.org/t/p/w780/7902tvNhWHaweGsZd3eZbFUgtVp.jpg","released":"2025-02-21T12:00:00.000Z","runtime":"53 min"},{"id":"tt32199328:1:5","season":1,"episode":5,"title":"Episodio 5","overview":"After downing the supply helicopter, First Sergeant Jung Tae-hwa realizes that survival at their station is impossible. He plans to lead his platoon in an escape from the zombie-ridden A Tower. Meanwhile, Young-joo's group finally reaches the gate of A Tower, only to be greeted by a horde of zombies.","thumbnail":"https://image.tmdb.org/t/p/w780/3TEc3IZatG2QkDLfWNxG0QWzLqa.jpg","released":"2025-02-28T12:00:00.000Z","runtime":"49 min"},{"id":"tt32199328:1:6","season":1,"episode":6,"title":"Episodio 6","overview":"Young-joo is left by herself at the Express Bus Terminal Station, but a stroke of luck leads her to a metro staff office, where she gathers supplies to battle the zombies. Meanwhile, Jae-yoon's group reaches Eden Hotel, where they run into Arron Park, who has survived there alone. But the group gets split up by an unexpected attack by the zombies, throwing them into separate hotel rooms.","thumbnail":"https://image.tmdb.org/t/p/w780/80NVOuuihGLH1GVTthbSbtO0Sru.jpg","released":"2025-03-07T12:00:00.000Z","runtime":"52 min"},{"id":"tt32199328:1:7","season":1,"episode":7,"title":"Episodio 7","overview":"On her way to Suseo Station, Young-joo meets a very special person, who helps her reminisce on the good memories with Jae-yoon. She relentlessly fights the zombies alone on her way to Jae-yoon. Meanwhile, Jae-yoon and the squad successfully reach the 35th floor through the ducts, but they must find another way down to the first floor.","thumbnail":"https://image.tmdb.org/t/p/w780/aENorTxAyVyeYRgKDzo7KMvuUus.jpg","released":"2025-03-14T12:00:00.000Z","runtime":"50 min"},{"id":"tt32199328:1:8","season":1,"episode":8,"title":"Episodio 8","overview":"Jae-yoon escapes the A Tower first and saves others with a brilliant idea. But they must endure another goodbye. In the meantime, Young-joo runs into people who are even more brutal than zombies. Will Jae-yoon and Young-joo, the two lovers fighting their own separate battle, finally reunite in this chaotic apocalypse?","thumbnail":"https://image.tmdb.org/t/p/w780/A6jwylNKmgqIfV5k4ZrGo0yNTQ.jpg","released":"2025-03-21T12:00:00.000Z","runtime":"56 min"}]}}