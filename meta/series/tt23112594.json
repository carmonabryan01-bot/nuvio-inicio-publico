ge.tmdb.org/t/p/w276_and_h350_face/tCTwnwBRjQzG656I68DwNRSZ1dz.jpg","tmdbId":6549114}],"certification":"TV-14","seasonPosters":["https://image.tmdb.org/t/p/w500/nNm8aY8OjAm0Lyn1khmoPNPNvmh.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt23112594:1:1","season":1,"episode":1,"title":"Sin ataduras","overview":"Visión comienza un viaje de autodescubrimiento y se ve perseguido por una fuerza letal.","thumbnail":"https://image.tmdb.org/t/p/w780/zNV1OOF71fzTYand5duFx3uaWlE.jpg","released":"2026-10-13T12:00:00.000Z","runtime":"56 min"},{"id":"tt23112594:1:2","season":1,"episode":2,"title":"Teseo","overview":"Visión enfrenta a su misterioso agresor mientras investiga si Tommy Shepherd es su hijo.","thumbnail":"https://image.tmdb.org/t/p/w780/sPFlMWA0YzOfuwys7BumrOJP5HR.jpg","released":"2026-10-13T12:00:00.000Z","runtime":"48 min"},{"id":"tt23112594:1:3","season":1,"episode":3,"title":"Reinicio","overview":"Vision y Thomas están huyendo, y Vision intenta analizar los antecedentes del joven y su posible conexión con su propio pasado. Al mismo tiempo, en el mundo digital interno, la lucha por el dominio entre las inteligencias artificiales comienza a recrudecerse.","thumbnail":"https://image.tmdb.org/t/p/w780/u2YwlI82Nm6pM3jFijt00lxY2Be.jpg","released":"2026-10-20T12:00:00.000Z","runtime":"54 min"},{"id":"tt23112594:1:4","season":1,"episode":4,"title":"Malware","overview":"Ultron consigue burlar las defensas del castillo mental e introduce código malicioso en el sistema de Visión, lo que altera su percepción de la realidad y sus recuerdos. Visión intenta distinguir los recuerdos reales de las alucinaciones creadas por el malware.","thumbnail":"https://image.tmdb.org/t/p/w780/6eVHqUOPEe1CIbvg4Dx6H4awFBR.jpg","released":"2026-10-20T12:00:00.000Z","runtime":"51 min"},{"id":"tt23112594:1:5","season":1,"episode":5,"title":"Firewall","overview":"Ultrón y Jocasta unen fuerzas. Lisa ayuda a Visión para evitar que lo capturen.","thumbnail":"https://image.tmdb.org/t/p/w780/6aBaiK5WPQrJ5L5cyBXJQwu4iGE.jpg","released":"2026-10-27T12:00:00.000Z","runtime":"48 min"},{"id":"tt23112594:1:6","season":1,"episode":6,"title":"Punto muerto","overview":"Visión y Paladín forman una frágil alianza y Thomas al fin descubre la verdad sobre su pasado.","thumbnail":"https://image.tmdb.org/t/p/w780/6R8uiUzWH4ht7EFhDgwH4u0wZxc.jpg","released":"2026-10-27T12:00:00.000Z","runtime":"57 min"},{"id":"tt23112594:1:7","season":1,"episode":7,"title":"Inmolación","overview":"La retorcida relación entre Visión y Ultrón se derrumba.","thumbnail":"https://image.tmdb.org/t/p/w780/xesTTPkIZoKYAMT0PH0jl49hMaK.jpg","released":"2026-11-03T12:00:00.000Z","runtime":"65 min"},{"id":"tt23112594:1:8","season":1,"episode":8,"title":"Forever","thumbnail":"https://image.tmdb.org/t/p/w780/5nSEYG0U4boOIYeMUBUE8MQjAk.jpg","released":"2026-11-10T12:00:00.000Z"}]}}