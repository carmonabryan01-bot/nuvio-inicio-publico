8565},{"name":"Riccardo DiLoreto","character":"Riccardo DiLoreto","photo":null,"tmdbId":4037054}],"certification":"TV-MA","seasonPosters":[null,"https://image.tmdb.org/t/p/w500/mAqJL7gjKPwdM1xGgpFPqbmel1S.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt4301160:1:1","season":1,"episode":1,"title":"Piloto","overview":"Jimmy Keene vive al máximo hasta que recibe una sentencia de 10 años. Tras las rejas, le ofrecen un trato muy arriesgado a cambio de su libertad.","thumbnail":"https://image.tmdb.org/t/p/w780/1tyDSxOGFUH63p46Pt6WsLoEmFY.jpg","released":"2022-07-07T12:00:00.000Z","runtime":"60 min"},{"id":"tt4301160:1:2","season":1,"episode":2,"title":"Aquí vamos, padre Abraham","overview":"La agente McCauley prepara a Jimmy para la misión. El detective Miller interroga a Larry sobre las mujeres desaparecidas, luego, le hace una prueba de polígrafo.","thumbnail":"https://image.tmdb.org/t/p/w780/uYVtjWKXdsps9aJLLZrEtpJFxtC.jpg","released":"2022-07-07T12:00:00.000Z","runtime":"53 min"},{"id":"tt4301160:1:3","season":1,"episode":3,"title":"De la boca a la mano","overview":"Enfrentando su transición a una prisión de máxima seguridad, Jimmy inicia una amistad con Larry. Se descubren inconsistencias en las historias de Larry.","thumbnail":"https://image.tmdb.org/t/p/w780/1KUmWKUlFU5gtNr7cngBudl0QSK.jpg","released":"2022-07-14T12:00:00.000Z","runtime":"62 min"},{"id":"tt4301160:1:4","season":1,"episode":4,"title":"Cuál es su nombre","overview":"Después de un motín en la prisión, Jimmy y Larry tienen tiempo de aprender más uno del otro.","thumbnail":"https://image.tmdb.org/t/p/w780/zulKSBiCEHfTSe7sdoRBRDb1B2K.jpg","released":"2022-07-21T12:00:00.000Z","runtime":"63 min"},{"id":"tt4301160:1:5","season":1,"episode":5,"title":"El lugar en el que yazco","overview":"El miedo y la paranoia en aumento de Jimmy lo llevan a provocar a Larry. McCauley y Miller descubren algo. La terapeuta de Larry se preocupa.","thumbnail":"https://image.tmdb.org/t/p/w780/zqIaF9QTS1l4qHAffqkUnzVJDiC.jpg","released":"2022-07-28T12:00:00.000Z","runtime":"58 min"},{"id":"tt4301160:1:6","season":1,"episode":6,"title":"Lo prometiste","overview":"Jimmy llega a su límite. Larry sospecha. McCauley y Miller hablan con una persona importante en la vida de Larry.","thumbnail":"https://image.tmdb.org/t/p/w780/xp8DscfWdcGBxbuLNBu4sTMuFih.jpg","released":"2022-08-04T12:00:00.000Z","runtime":"64 min"},{"id":"tt4301160:0:1","season":0,"episode":1,"title":"Cat and Mouse","overview":"-","released":"2022-07-08T12:00:00.000Z","runtime":"2 min"}]}}