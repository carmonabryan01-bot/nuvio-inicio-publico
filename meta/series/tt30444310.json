db.org/t/p/w276_and_h350_face/54Np4lBqGM36uwpzRc4KztJxGJz.jpg","tmdbId":3289},{"name":"Martha Wells","character":"Martha Wells","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/3i9wDhRf6Sb8ydwmTtIvJ77EATA.jpg","tmdbId":4430260}],"certification":"TV-MA","seasonPosters":[null,"https://image.tmdb.org/t/p/w500/zwu7yXEGHvJv9va0SmkFEJGn2L7.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt30444310:1:1","season":1,"episode":1,"title":"LibreComercio","overview":"En una nueva misión, el libre albedrío que Matabot acaba de obtener hace que el equipo de PreservaciónAux sospeche.","thumbnail":"https://image.tmdb.org/t/p/w780/rHwP546wCMI3rihVWUCKDHfRd0h.jpg","released":"2025-05-15T12:00:00.000Z","runtime":"29 min"},{"id":"tt30444310:1:2","season":1,"episode":2,"title":"Contacto visual","overview":"Mensah y Bharadwaj arriesgan todo para investigar una región misteriosa. Gurathin encara a Matabot.","thumbnail":"https://image.tmdb.org/t/p/w780/4W0SGwmRIw4qnTYZ2a7qSq06yHc.jpg","released":"2025-05-15T12:00:00.000Z","runtime":"25 min"},{"id":"tt30444310:1:3","season":1,"episode":3,"title":"Evaluación de riesgo","overview":"El equipo de PresAux se dirige a otra base para encontrar respuestas. Matabot termina en un enfrentamiento con otra SegUnidad.","thumbnail":"https://image.tmdb.org/t/p/w780/nypm3RSjedTMp8bcAK7vGrINZio.jpg","released":"2025-05-22T12:00:00.000Z","runtime":"23 min"},{"id":"tt30444310:1:4","season":1,"episode":4,"title":"Protocolo de velocidad de escape","overview":"Mientras un enemigo le apunta a Matabot, una aliada intenta conseguir una vía de escape. El equipo tiene problemas organizando el liderazgo y debe enfrentar un ultimátum.","thumbnail":"https://image.tmdb.org/t/p/w780/nTNITwliXaYXSV4DtMMqTeKs1Id.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"23 min"},{"id":"tt30444310:1:5","season":1,"episode":5,"title":"Las penas infinitas del robot de ataque","overview":"PresAux hace lo posible por escapar. La tensión aumenta mientras la confianza del equipo se pone a prueba. Una sobreviviente de DeltFall se les une.","thumbnail":"https://image.tmdb.org/t/p/w780/pNihCocG5G11ViFvtFuPFYHi79T.jpg","released":"2025-06-05T12:00:00.000Z","runtime":"24 min"},{"id":"tt30444310:1:6","season":1,"episode":6,"title":"Red de órdenes","overview":"Un contratiempo hace que el equipo se estrese por encontrar una solución. Mensah lo apuesta todo por un procedimiento peligroso. Leebeebee muestra otra cara.","thumbnail":"https://image.tmdb.org/t/p/w780/dEPh66yXnbg1GPLbKq1TAj4a79y.jpg","released":"2025-06-12T12:00:00.000Z","runtime":"26 min"},{"id":"tt30444310:1:7","season":1,"episode":7,"title":"Especie complementaria","overview":"Matabot lidia con los daños colaterales de sus acciones y detecta una amenaza crítica. El equipo se dirige a un nuevo lugar lleno de sorpresas con tal de evadir el peligro.","thumbnail":"https://image.tmdb.org/t/p/w780/psUQjw1fmpDaH2NUO50aC1z6qUm.jpg","released":"2025-06-19T12:00:00.000Z","runtime":"23 min"},{"id":"tt30444310:1:8","season":1,"episode":8,"title":"Objeto externo","overview":"PresAux recibe un mensaje de un grupo rival. Gurathin logra ver el pasado sangriento de Matabot.","thumbnail":"https://image.tmdb.org/t/p/w780/f2L8w8zHIjgtbo0h0FOXxJ9xBqB.jpg","released":"2025-06-26T12:00:00.000Z","runtime":"23 min"},{"id":"tt30444310:1:9","season":1,"episode":9,"title":"Sistemas Críticos","overview":"Matabot toma el liderazgo en una situación crítica. Gurathin y Pin-Lee idean un plan. Mensah actúa por su cuenta.","thumbnail":"https://image.tmdb.org/t/p/w780/blDXRcLF1ZscN5ZkP0V444kYCSO.jpg","released":"2025-07-03T12:00:00.000Z","runtime":"29 min"},{"id":"tt30444310:1:10","season":1,"episode":10,"title":"El perímetro","overview":"El destino de Matabot pende de un hilo. En el Confín Corporativo, PresAux hace una petición extrema.","thumbnail":"https://image.tmdb.org/t/p/w780/shtg4jBLkdAP4ATzTUHUA2f3d9e.jpg","released":"2025-07-10T12:00:00.000Z","runtime":"35 min"},{"id":"tt30444310:0:1","season":0,"episode":1,"title":"Murderbot: Unmasked","overview":"Killer instincts. Zero social skills. Murderbot just wants to be left alone and not deal with humans and their messy emotions.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11157325/screencap/6832f4a8bc0d4.jpg","runtime":"2 min"}]}}