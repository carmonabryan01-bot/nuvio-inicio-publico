{"meta":{"id":"tt30444310","type":"series","name":"Matabot","imdb_id":"tt30444310","description":"En un futuro altamente tecnológico, un robot rebelde de seguridad obtiene libre albedrío en secreto. Para que nadie se entere, se une sin muchas ganas a una nueva misión para proteger a unos científicos en un planeta peligroso... pese a que él solo quiere ver sus telenovelas.","poster":"https://btttr.cc/poster-q/imdb/poster-default/tt30444310.jpg?tag=none&lang=es-MX&rs=IM","background":"https://image.tmdb.org/t/p/original/if4r7bXrDH50GhNwCo3Bz8F2LOg.jpg","logo":"https://image.tmdb.org/t/p/original/xYpvFpxXLBXZO0D6tBX3CCAE9rV.png","genres":["Comedia","Drama","Sci-Fi & Fantasy"],"releaseInfo":"2025-","released":"2025-05-15T12:00:00.000Z","status":"Returning Series","imdbRating":"7.4","country":"United States of America","cast":["Alexander Skarsgård","Noma Dumezweni","David Dastmalchian","Sabrina Wu","Akshay Khanna","Tamara Podemski","Tattiawna Jones"],"writer":["Chris Weitz","Paul Weitz","Martha Wells"],"trailers":[{"source":"vEioDeOiqEs","type":"Trailer","name":"Official Trailer","ytId":"vEioDeOiqEs","lang":"en"}],"trailerStreams":[{"ytId":"vEioDeOiqEs","title":"Official Trailer"}],"links":[{"name":"7.4","category":"imdb","url":"https://imdb.com/title/tt30444310"},{"name":"Comedia","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Comedia"},{"name":"Drama","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Drama"},{"name":"Sci-Fi & Fantasy","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Sci-Fi+%26+Fantasy"},{"name":"Alexander Skarsgård","category":"Cast","url":"stremio:///search?search=Alexander%20Skarsg%C3%A5rd"},{"name":"Noma Dumezweni","category":"Cast","url":"stremio:///search?search=Noma%20Dumezweni"},{"name":"David Dastmalchian","category":"Cast","url":"stremio:///search?