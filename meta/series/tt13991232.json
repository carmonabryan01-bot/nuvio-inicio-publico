vrk.jpg","https://image.tmdb.org/t/p/w500/waLbm384SQDwLTCn6ttPqQS5kfV.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt13991232:1:1","season":1,"episode":1,"title":"1883","overview":"La familia Dutton se embarca hacia el oeste a través del último bastión de la indómita América. James llega a Texas, donde él y su familia se preparan para recorrer las Grandes Llanuras en busca de un nuevo hogar y la promesa de una oportunidad.","thumbnail":"https://image.tmdb.org/t/p/w780/xwGZylrUoMDnioy0DRmMnpY3WQf.jpg","released":"2021-12-19T12:00:00.000Z","runtime":"67 min"},{"id":"tt13991232:1:2","season":1,"episode":2,"title":"Detrás de nosotros, un acantilado","overview":"Thomas y Shea reclutan a James y a algunos vaqueros locales para acorralar una manada de ganado. Al comenzar su viaje, la caravana se enfrenta a algunos de los muchos peligros que enfrentarán en el camino.","thumbnail":"https://image.tmdb.org/t/p/w780/rdNWQjFESo9nqNZSAmlPVSDhloA.jpg","released":"2021-12-19T12:00:00.000Z","runtime":"59 min"},{"id":"tt13991232:1:3","season":1,"episode":3,"title":"Río","overview":"James choca con Shea y Thomas sobre una decisión importante. Las tensiones aumentan en el campamento cuando se hace una acusación. Elsa comienza a flirtear con un vaquero.","thumbnail":"https://image.tmdb.org/t/p/w780/vtvlsFhen064XrpWfQWecx9dw5e.jpg","released":"2021-12-26T12:00:00.000Z","runtime":"44 min"},{"id":"tt13991232:1:4","season":1,"episode":4,"title":"El cruce","overview":"El grupo se enfrenta a la angustiosa tarea de cruzar el río con sus carros y provisiones. Thomas y Noemí se acercan más.","thumbnail":"https://image.tmdb.org/t/p/w780/j1TGBsRsHnI1mDh7aI2R12ztjus.jpg","released":"2022-01-09T12:00:00.000Z","runtime":"55 min"},{"id":"tt13991232:1:5","season":1,"episode":5,"title":"Los colmillos de la libertad","overview":"Shea y Thomas hacen frente a las consecuencias del cruce del río, pero hay poco tiempo para el duelo y muchos desafíos por delante. Elsa y Ennis comparten un momento romántico.","thumbnail":"https://image.tmdb.org/t/p/w780/5QsxHkxXcktqunh40xJJfdnTvI5.jpg","released":"2022-01-16T12:00:00.000Z","runtime":"56 min"},{"id":"tt13991232:1:6","season":1,"episode":6,"title":"Aburriendo al diablo","overview":"Shea ayuda a Elsa a sobrellevar su pérdida. El grupo cruza otro río y se prepara para entrar en territorio indio. Thomas le compra un regalo a Noemi.","thumbnail":"https://image.tmdb.org/t/p/w780/4SUAp585VcBRhgKVQUfntCGtAel.jpg","released":"2022-01-30T12:00:00.000Z","runtime":"51 min"},{"id":"tt13991232:1:7","season":1,"episode":7,"title":"Cabello amarillo relámpago","overview":"Elsa hace un amigo poco probable; el grupo se enfrenta a un angustioso desafío de la madre naturaleza; el campamento busca uno de los suyos.","thumbnail":"https://image.tmdb.org/t/p/w780/vAiUtQqahU2TeUHyLA8Ub6A19Q0.jpg","released":"2022-02-06T12:00:00.000Z","runtime":"53 min"},{"id":"tt13991232:1:8","season":1,"episode":8,"title":"El llanto de la rendición","overview":"Elsa toma una gran decisión. Shea enfrenta dudas a medida que se acerca el invierno.","thumbnail":"https://image.tmdb.org/t/p/w780/8qwNxHjRpMxVQkbx8sNNRTGwZXz.jpg","released":"2022-02-13T12:00:00.000Z","runtime":"55 min"},{"id":"tt13991232:1:9","season":1,"episode":9,"title":"Nubes de carreras","overview":"Un malentendido desemboca en una batalla de graves consecuencias.","thumbnail":"https://image.tmdb.org/t/p/w780/qrGX4NYc02lKroktWBSWFHFgpb9.jpg","released":"2022-02-20T12:00:00.000Z","runtime":"56 min"},{"id":"tt13991232:1:10","season":1,"episode":10,"title":"Este no es tu cielo","overview":"James y Margaret se enfrentan a una decisión difícil. Shea y Thomas toman medidas audaces para ayudar a uno de los suyos.","thumbnail":"https://image.tmdb.org/t/p/w780/7p1scBDa5XyRjzhp4yBhFUEI6mo.jpg","released":"2022-02-27T12:00:00.000Z","runtime":"65 min"},{"id":"tt13991232:0:1","season":0,"episode":1,"title":"1883: The Road West","overview":"A behind-the-scenes look at the making of 1883.","