,{"name":"장영남","category":"Cast","url":"stremio:///search?search=%EC%9E%A5%EC%98%81%EB%82%A8"},{"name":"최정규","category":"Directors","url":"stremio:///search?search=%EC%B5%9C%EC%A0%95%EA%B7%9C"},{"name":"권소라","category":"Writers","url":"stremio:///search?search=%EA%B6%8C%EC%86%8C%EB%9D%BC"},{"name":"서재원","category":"Writers","url":"stremio:///search?search=%EC%84%9C%EC%9E%AC%EC%9B%90"}],"app_extras":{"cast":[{"name":"남주혁","character":"Gu-cheon","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/kuLC8pR24kbEIAjfg3WpKW41Kcl.jpg","tmdbId":1459772},{"name":"노윤서","character":"Saeng-gang","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/A67wGhTozfav5saZ1Umi5f98Ezb.jpg","tmdbId":3218480},{"name":"조승우","character":"King","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/agXysHUmaUdHrEQAZ2ZMvMR5oCU.jpg","tmdbId":126495},{"name":"장영남","character":"Queen Dowager","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/u0hl8WSswFhKVaKwaMAERU0xUJk.jpg","tmdbId":93996}],"directors":[{"name":"최정규","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/y6L0IHxDJ5J3VHFkYklxHQS7eta.jpg","tmdbId":1674545}],"writers":[{"name":"권소라","character":"권소라","photo":null,"tmdbId":2132323},{"name":"서재원","character":"서재원","photo":null,"tmdbId":2132216}],"certification":"TV-MA","seasonPosters":[null,"https://image.tmdb.org/t/p/w500/wJoNpRjonE3B5vSWMNuBvaIPZvl.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt35051401:1:1","season":1,"episode":1,"title":"Episodio 1","overview":"Tras una misteriosa muerte, el rey convoca al geomante Gu‑cheon para expulsar a un espíritu del estanque. Saeng‑gang, que oye a los muertos, también se presenta ante él.","thumbnail":"https://image.tmdb.org/t/p/w780/spI7uWPdfrCvJTVebkZZU1IJieq.jpg","released":"2026-07-17T12:00:00.000Z","runtime":"46 min"},{"id":"tt35051401:1:2","season":1,"episode":2,"title":"Episodio 2","overview":"Luego de vivir un incidente peligroso mientras buscaban al espíritu del estanque, Gu‑cheon y Saeng‑gang descubren la verdad detrás del ente del depósito de sal.","thumbnail":"https://image.tmdb.org/t/p/w780/gc45nAOxEAtHsAe5Kus5GlkoppH.jpg","released":"2026-07-17T12:00:00.000Z","runtime":"53 min"},{"id":"tt35051401:1:3","season":1,"episode":3,"title":"Episodio 3","overview":"Cuando el rey le ordena que salve al príncipe o pague con su vida, Gu‑cheon se ve obligado a ingresar al reino de los Gwi y se enfrenta al espíritu de un exguardia real.","thumbnail":"https://image.tmdb.org/t/p/w780/gosF5tbLPUC60esXgpcC0ACc0ZO.jpg","released":"2026-07-17T12:00:00.000Z","runtime":"49 min"},{"id":"tt35051401:1:4","season":1,"episode":4,"title":"Episodio 4","overview":"Gu‑cheon y Saeng‑gang intentan desterrar al espíritu del estanque para siempre. Como Gu‑cheon sigue albergando sospechas en torno a las muertes, ambos vuelven a reunirse.","thumbnail":"https://image.tmdb.org/t/p/w780/9t6adIrMRdAUiDWI4wlEz72v4z0.jpg","released":"2026-07-17T12:00:00.000Z","runtime":"54 min"},{"id":"tt35051401:1:5","season":1,"episode":5,"title":"Episodio 5","overview":"Gu‑cheon escapa del peligro con ayuda de Saeng‑gang. Cuando el rey enferma, Gu‑cheon lucha contra el ente maldito, pero un espíritu guardián se interpone en su camino.","thumbnail":"https://image.tmdb.org/t/p/w780/ni5KEFwhKmu41mF7TO8hfFSjuwM.jpg","released":"2026-07-17T12:00:00.000Z","runtime":"46 min"},{"id":"tt35051401:1:6","season":1,"episode":6,"title":"Episodio 6","overview":"Mientras Gu‑cheon pelea, Saeng‑gang queda expuesta al peligro. La verdad está cerca, pero cuando Gu‑cheon pierde la vista, la misión se ve amenazada.","thumbnail":"https://image.tmdb.org/t/p/w780/2vWnUAnqiYRfin7z7pt3LFa46MO.jpg","released":"2026-07-17T12:00:00.000Z","runtime":"50 min"},{"id":"tt35051401:1:7","season":1,"episode":7,"title":"Episodio 7","overview":"El rey y la reina madre chocan por las tragedias ocurridas, mientras los espíritus resentidos se acercan. Gu‑cheon y Saeng‑gang se arman de valor para un enfrentamiento final.","thumbnail":"https://image.tmdb.org/t/p/w780/24Ofu8HmdB5VDRxpvF4hnsohEMx.jpg","released":"2026-07-17T12:00:00.000Z","runtime":"46 min"},{"id":"tt35051401:1:8","season":1,"episode":8,"title":"Episodio 8","overview":"El caos se apodera del palacio mientras un espíritu sediento de venganza devora todo a su paso. ¿Podrán Gu-cheon y Saeng-gang detenerlo antes de que sea demasiado tarde?","thumbnail":"https://image.tmdb.org/t/p/w780/eYVnQymmcplrnK8eg337E7GuCTv.jpg","released":"2026-07-17T12:00:00.000Z","runtime":"59 min"},{"id":"tt35051401:0:1","season":0,"episode":1,"title":"After 300 Years","released":"2026-07-20T12:00:00.000Z","runtime":"1 min"}]}}