hasScheduledVideos":true},"videos":[{"id":"tt18224594:1:1","season":1,"episode":1,"title":"Hades","overview":"Una redada obliga a Cora a infiltrarse en el Departamento de Policía de Los Ángeles para recuperar un objeto confiscado que expone una verdad oculta.","thumbnail":"https://image.tmdb.org/t/p/w780/pTdEkaadTPdx3zJlSk82trpnbCR.jpg","released":"2026-11-24T12:00:00.000Z","runtime":"63 min"},{"id":"tt18224594:1:2","season":1,"episode":2,"title":"Formadora de mundos","overview":"Esforzándose por cubrir sus secretos, Cora y Olwen van tras un colega rebelde.","thumbnail":"https://image.tmdb.org/t/p/w780/pxM6TpiVjlQfcTwP3GXC451go6C.jpg","released":"2026-11-24T12:00:00.000Z","runtime":"62 min"},{"id":"tt18224594:1:3","season":1,"episode":3,"title":"Amigables amigos","overview":"Cora arriesga su identidad cuando su hermano está en peligro. Los errores de Olwen la obligan a recordar su historia con un replicante desaparecido.","thumbnail":"https://image.tmdb.org/t/p/w780/7XqmcxB3sV15l8nZ1VpZUV1hscB.jpg","released":"2026-11-24T12:00:00.000Z","runtime":"56 min"},{"id":"tt18224594:1:4","season":1,"episode":4,"title":"He aquí, el recuerdo","overview":"Cora y Olwen buscan fugitivos en un escondite en la Ciudad de México. Las ambiciones oscuras chocan con los secretos ocultos y ambas mujeres deben enfrentar el dolor de su pasado.","thumbnail":"https://image.tmdb.org/t/p/w780/ikYwivN7l9C0Cp8elnSuvUtrHe9.jpg","released":"2026-11-24T12:00:00.000Z","runtime":"53 min"},{"id":"tt18224594:1:5","season":1,"episode":5,"title":"Milord","overview":"Cora investiga su pasado mientras Olwen enfrenta nuevas amenazas, y se produce un peligroso ajuste de cuentas.","thumbnail":"https://image.tmdb.org/t/p/w780/jwLOpc2awdFzEHQ6vDLbAKmdH1Y.jpg","released":"2026-11-24T12:00:00.000Z","runtime":"54 min"},{"id":"tt18224594:1:6","season":1,"episode":6,"title":"Matar a los asesinos","overview":"Cora y Olwen forjan una alianza incómoda para ir tras una reliquia perdida. En el hogar de Cora, acechan viejos fantasmas y nuevos peligros. Ahora que son la presa, deben decidir si compiten entre sí o sobreviven juntas.","thumbnail":"https://image.tmdb.org/t/p/w780/iTP4iKqZp5bB25FdoFTANrsph3N.jpg","released":"2026-11-24T12:00:00.000Z","runtime":"51 min"},{"id":"tt18224594:1:7","season":1,"episode":7,"title":"Un beso más, amor","overview":"Sin más tiempo y sin más opciones, Olwen le pide ayuda a Cora. Su incómoda alianza se pone a prueba cuando el pasado toca a la puerta.","thumbnail":"https://image.tmdb.org/t/p/w780/x9eCtH6XK4g0RUG2GpJONwvFeTG.jpg","released":"2026-11-24T12:00:00.000Z","runtime":"57 min"},{"id":"tt18224594:1:8","season":1,"episode":8,"title":"Comparte la fantasía","overview":"Las horas finales de Olwen coinciden con la desesperada búsqueda de Cora por recuperar su legado. Cuando las ambiciones chocan, ya nadie es el mismo.","thumbnail":"https://image.tmdb.org/t/p/w780/z5fOJ6kjz5jq5qEp5LVsb0BOGz.jpg","released":"2026-11-24T12:00:00.000Z","runtime":"62 min"}]}}