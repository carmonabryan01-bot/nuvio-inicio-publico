ctor/303148/photo/686a476bb4aaa.jpg","tmdbId":1565358},{"name":"中島ヨシキ","character":"Yuta Maki","photo":"https://artworks.thetvdb.com/banners/v4/actor/7868460/photo/686a487e4ab3a.jpg","tmdbId":2161808},{"name":"若山詩音","character":"Yuki Tadokoro","photo":"https://artworks.thetvdb.com/banners/v4/actor/8157826/photo/686a48d5eed2d.jpg","tmdbId":2363904}],"writers":[{"name":"竹下良平","character":"竹下良平","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/c3iDk7Z0oYGLCop3edpAq32O4Jb.jpg","tmdbId":1780651},{"name":"モクモクれん","character":"モクモクれん","photo":null,"tmdbId":5087663}],"certification":"TV-14","seasonPosters":["https://artworks.thetvdb.com/banners/v4/season/2129284/posters/6898d431c529c.jpg","https://artworks.thetvdb.com/banners/v4/season/2208689/posters/68d813f9e2d73.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt33028568:1:1","season":1,"episode":1,"title":"1. Reemplazo","overview":"Yoshiki confronta a Hikaru por sus sospechas y descubre la aterradora verdad. Aunque intentan vivir con normalidad, comienzan a ocurrir incidentes inquietantes.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10827724/screencap/68626e9642e7a.jpg","released":"2025-07-06T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:2","season":1,"episode":2,"title":"2. Sospecha","overview":"Mientras Yoshiki y Hikaru acompañan a sus compañeros de clase a un espeluznante sendero de montaña, un hombre misterioso llega a la aldea Kubitachi y comienza a investigar.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217538/screencap/686fa75c225e6.jpg","released":"2025-07-13T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:3","season":1,"episode":3,"title":"3. Negación","overview":"Al recordar su infancia con Hikaru, Yoshiki sigue luchando con sus complejas emociones. Desesperado, recurre a Kurebayashi.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217539/screencap/6878ec6ea32e5.jpg","released":"2025-07-20T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:4","season":1,"episode":4,"title":"4. Festival de verano","overview":"Mientras Yoshiki asiste al festival de verano con Hikaru, los ancianos de la aldea se preocupan por la reciente muerte y Tanaka termina con más preguntas que respuestas.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217540/screencap/6883a159ef7af.jpg","released":"2025-07-27T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:5","season":1,"episode":5,"title":"5. Peluca fantasma","overview":"Cuando la hermana de Yoshiki descubre un espeluznante mechón de cabello en el baño, Hikaru visita la casa de los Tsujinaka para investigar, pero las cosas toman un giro mortal.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217541/screencap/688c3f865250c.jpg","released":"2025-08-03T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:6","season":1,"episode":6,"title":"6. Asako","overview":"Yoshiki y sus compañeros comentan una historia que les asignó su profesor. Más tarde, en una pijamada, las agudas observaciones de Asako la pusieron en grave peligro.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217542/screencap/6894ab56c2c47.jpg","released":"2025-08-10T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:7","season":1,"episode":7,"title":"7. Determinación","overview":"Después de darse cuenta de que Hikaru es realmente peligroso, Yoshiki decide que debe actuar e invita a su mejor amigo a faltar juntos a la escuela.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217543/screencap/689e4b6f9af71.jpg","released":"2025-08-17T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:8","season":1,"episode":8,"title":"8. Contacto","overview":"Yoshiki y Hikaru investigan a Nonuki-sama y su vínculo con la historia de Kubitachi. En la biblioteca, obtienen una pista importante de una fuente sorprendente.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217544/screencap/68a72d306deb1.jpg","released":"2025-08-24T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:9","season":1,"episode":9,"title":"9. El viejo Takeda","overview":"Kurebayashi comparte su conocimiento sobre las impurezas con los chicos. Más tarde, el mayor de los Takeda se enoja por la ignorancia de Hikaru sobre la historia de Indo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217545/screencap/68b981e841656.jpg","released":"2025-09-07T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:10","season":1,"episode":10,"title":"10. Verdad","overview":"El encuentro sorpresa de los chicos con Tanaka los lleva al hospital. Al regresar a la escuela, Yoshiki descifra la verdad sobre Nonuki-sama.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217546/screencap/68c4124e9661f.jpg","released":"2025-09-14T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:11","season":1,"episode":11,"title":"11. El pecado de Indo","overview":"Aunque indeciso, Yoshiki le pregunta a su padre sobre el turbio pasado y el ritual secreto de la familia Indo. Más tarde, Hikaru pierde el control en la escuela y se siente profundamente afectado.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217547/screencap/68cd50e364d4a.jpg","released":"2025-09-21T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:1:12","season":1,"episode":12,"title":"12. Su lugar","overview":"Mientras todos asisten a la asamblea escolar, Asako encuentra a Hikaru deambulando por los pasillos. A solas en la playa, Hikaru le revela sus planes finales a Yoshiki.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11217548/screencap/68d557fd4ec5b.jpg","released":"2025-09-28T12:00:00.000Z","runtime":"23 min"},{"id":"tt33028568:2:1","season":2,"episode":1,"title":"13. Episode 1","runtime":"23 min"}]}}