h.","thumbnail":"https://image.tmdb.org/t/p/w780/uBePrF9AyR3AkysXOvjQoLqPP1y.jpg","released":"2017-10-06T12:00:00.000Z","runtime":"42 min"},{"id":"tt4154858:1:4","season":1,"episode":4,"title":"Make Way For... Medusa","overview":"The search for Black Bolt continues on Earth; meanwhile, Maximus makes bold moves to cement his status as the new ruler of Attilan.","thumbnail":"https://image.tmdb.org/t/p/w780/5dCGgtsOKY8ligyzq3MFLtqdgaT.jpg","released":"2017-10-13T12:00:00.000Z","runtime":"41 min"},{"id":"tt4154858:1:5","season":1,"episode":5,"title":"Something Inhuman This Way Comes...","overview":"On the run from Auran’s forces, Black Bolt and Medusa reluctantly work with Louise to help locate the rest of their family. Back on Attilan, Maximus’ actions change the game completely.","thumbnail":"https://image.tmdb.org/t/p/w780/mCkLvygSod01GUTdNjgRK6jKyGx.jpg","released":"2017-10-20T12:00:00.000Z","runtime":"43 min"},{"id":"tt4154858:1:6","season":1,"episode":6,"title":"The Gentleman's Name Is Gorgon","overview":"Gorgon and Karnak take on Auran and her Inhuman army with disastrous results.","thumbnail":"https://image.tmdb.org/t/p/w780/aE5UpjDkA4GM3IA1qfX7HiIDsAC.jpg","released":"2017-10-27T12:00:00.000Z","runtime":"42 min"},{"id":"tt4154858:1:7","season":1,"episode":7,"title":"Havoc in the Hidden Land","overview":"The Royal Family returns to Attilan and comes face to face with Maximus.","thumbnail":"https://image.tmdb.org/t/p/w780/uxj2L0ENZxUGFBv3QwSOgIayh8c.jpg","released":"2017-11-03T12:00:00.000Z","runtime":"42 min"},{"id":"tt4154858:1:8","season":1,"episode":8,"title":"...And Finally: Black Bolt","overview":"It’s brother versus brother as the final showdown between Black Bolt and Maximus takes an unexpected turn – one with lasting consequences for all of Inhumanity.","thumbnail":"https://image.tmdb.org/t/p/w780/fCuB4fMvTMawi0Q2UnPMsbHkiez.jpg","released":"2017-11-10T12:00:00.000Z","runtime":"42 min"}]}}