w276_and_h350_face/jJLJuR7FNHYL1fB5igjj7IXzOel.jpg","tmdbId":65827}],"writers":[{"name":"J.J. Abrams","character":"J.J. Abrams","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/k4IWd2RV5kY1kAL2VgKQwFvnCLP.jpg","tmdbId":15344},{"name":"LaToya Morgan","character":"LaToya Morgan","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/bSmB4SmYg21XRI8FhaWYzSOLFMB.jpg","tmdbId":1539831}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/wYBsKEFU0qHdhSI9QtQjL8HELMn.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt12160826:1:1","season":1,"episode":1,"title":"Baltimore Lo Cambia Todo","overview":"La agente del FBI Nina Hayes debe atrapar a un jefe criminal de Phoenix y va tras Jim Ellis, un chofer de fuga reacio. Pero algo más turbio le espera.","thumbnail":"https://image.tmdb.org/t/p/w780/ejwbW3t39YUjWF8UtZ0VejQXg5P.jpg","released":"2025-05-15T12:00:00.000Z","runtime":"52 min"},{"id":"tt12160826:1:2","season":1,"episode":2,"title":"Mentes Sospechosas","overview":"Tras aceptar de mala gana colaborar con Nina, Jim es chantajeado por un policía corrupto y se ve forzado a hacer un trato con un peligroso intermediario.","thumbnail":"https://image.tmdb.org/t/p/w780/aamBCvMQFmDLDCWIomfandPco9g.jpg","released":"2025-05-22T12:00:00.000Z","runtime":"49 min"},{"id":"tt12160826:1:3","season":1,"episode":3,"title":"No Eres Bueno","overview":"Nina y Awan siguen una pista que requiere ir en busca de un exagente inestable en un sanatorio. Por otro lado, Jim lleva a Saxton a un encuentro secreto que despierta sus sospechas y lo lleva a buscar respuestas.","thumbnail":"https://image.tmdb.org/t/p/w780/cGeT7rJRByY3RAhhyg6Uih7A2Tm.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"48 min"},{"id":"tt12160826:1:4","season":1,"episode":4,"title":"Criminal de Velocidad Supersónica","overview":"Tras enterarse de que lo persigue un asesino, Jim y Royce, el hijo de Saxton, son emboscados por ladrones durante una entrega riesgosa. Mientras tanto, Nina y Awan siguen la pista de un mensaje críptico que los lleva a un lugar inesperado.","thumbnail":"https://image.tmdb.org/t/p/w780/m2Kdz5CdchG41B1X0FTVfxzF6Zo.jpg","released":"2025-06-05T12:00:00.000Z","runtime":"48 min"},{"id":"tt12160826:1:5","season":1,"episode":5,"title":"Ravishing Light and Glory","overview":"As they infiltrate Saxton's world, Jim and Nina uncover a conspiracy of murder, drugs, and cover-ups – while a shadowy enemy moves to silence them.","thumbnail":"https://image.tmdb.org/t/p/w780/uLkv73WGz6eGXuN10hDLzDXQ2BT.jpg","released":"2025-06-12T12:00:00.000Z","runtime":"49 min"},{"id":"tt12160826:1:6","season":1,"episode":6,"title":"Встречают по одёжке (Meet by the Clothes)","overview":"After surviving a bloody ambush, Jim and Nina grow closer as their enemies multiply – and a high-stakes conspiracy spirals out of control.","thumbnail":"https://image.tmdb.org/t/p/w780/oFhumsBEOx6YmsyN3WCtAcaGC7g.jpg","released":"2025-06-19T12:00:00.000Z","runtime":"44 min"},{"id":"tt12160826:1:7","season":1,"episode":7,"title":"K-129","overview":"In Vegas, Jim discovers shocking secrets about his brother's death, while Nina's cover is blown by an old enemy's shocking return.","thumbnail":"https://image.tmdb.org/t/p/w780/5uhfOVvpcBpTHmITdH7LqMWKE6R.jpg","released":"2025-06-26T12:00:00.000Z","runtime":"52 min"},{"id":"tt12160826:1:8","season":1,"episode":8,"title":"66 Reno Split","overview":"After discovering the truth about Jim and Nina, Saxton makes plans to destroy them – and his mob rivals – once and for all.","thumbnail":"https://image.tmdb.org/t/p/w780/haQzIm5rflWGoDeIhlXXAXwhI1v.jpg","released":"2025-07-03T12:00:00.000Z","runtime":"54 min"}]}}