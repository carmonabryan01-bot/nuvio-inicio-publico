videos":[{"id":"tt34771210:1:1","season":1,"episode":1,"title":"Episodio 1","overview":"Encerrado en prisión por un asesinato que no cometió, David Burroughs decide escapar tras una impactante revelación: su hijo podría seguir vivo.","thumbnail":"https://image.tmdb.org/t/p/w780/tDUUexyRzcPrjNaz9sZfcdnYTgS.jpg","released":"2026-06-18T12:00:00.000Z","runtime":"48 min"},{"id":"tt34771210:1:2","season":1,"episode":2,"title":"Episodio 2","overview":"El FBI interviene mientras David intenta mantenerse oculto. Los Mackenzie son bombardeados con preguntas sobre su participación en el caso.","thumbnail":"https://image.tmdb.org/t/p/w780/6OEIZuhL8FaZVsRN4BG0Iz3rECO.jpg","released":"2026-06-18T12:00:00.000Z","runtime":"45 min"},{"id":"tt34771210:1:3","season":1,"episode":3,"title":"Episodio 3","overview":"David y Rachel arriesgan su libertad para encontrar a Hilde Winslow. Lenny y Philip hacen una gran revelación sobre la noche de la muerte de Matthew.","thumbnail":"https://image.tmdb.org/t/p/w780/49wwShw8OGYYdk1DUqI2b22Wyk1.jpg","released":"2026-06-18T12:00:00.000Z","runtime":"38 min"},{"id":"tt34771210:1:4","season":1,"episode":4,"title":"Episodio 4","overview":"Hayden debe decidir si ayuda o no a su inesperado visitante. Rachel se topa con una pared. Lenny le presenta a Cheryl nuevas pruebas cruciales.","thumbnail":"https://image.tmdb.org/t/p/w780/wzbLwhFShwo6bpABnIQJNhqiswg.jpg","released":"2026-06-18T12:00:00.000Z","runtime":"45 min"},{"id":"tt34771210:1:5","season":1,"episode":5,"title":"Episodio 5","overview":"David recurre a medidas desesperadas para obligar a un enemigo a aparecer. Rachel intenta reparar los daños tras una gran traición. Hayden debe elegir un bando.","thumbnail":"https://image.tmdb.org/t/p/w780/bkhOGVJ6yHducLxPpejPspCbMZw.jpg","released":"2026-06-18T12:00:00.000Z","runtime":"45 min"},{"id":"tt34771210:1:6","season":1,"episode":6,"title":"Episodio 6","overview":"David debe tomar una decisión devastadora. Rachel enfrenta un gran peligro. La búsqueda de la verdad por parte de Sarah y Max cobra un costo muy alto.","thumbnail":"https://image.tmdb.org/t/p/w780/5fkT9NCvSYr2orDfF0ekKH2T7XK.jpg","released":"2026-06-18T12:00:00.000Z","runtime":"38 min"},{"id":"tt34771210:1:7","season":1,"episode":7,"title":"Episodio 7","overview":"En el hospital hay una pista clave para encontrar a Matthew, pero David y Rachel deben convencer a Ronald para que ayude. Sarah cuenta con un nuevo aliado para su investigación.","thumbnail":"https://image.tmdb.org/t/p/w780/m0AdtPqDZDcXDKZcTEExGFJKGvG.jpg","released":"2026-06-18T12:00:00.000Z","runtime":"36 min"},{"id":"tt34771210:1:8","season":1,"episode":8,"title":"Episodio 8","overview":"Con una aliada inesperada de su lado, David y Rachel tienen una oportunidad de rescatar a Matthew de sus captores... antes de que desaparezca para siempre.","thumbnail":"https://image.tmdb.org/t/p/w780/TOs0PsDUEz8mlo3XKAIBKQ0SOW.jpg","released":"2026-06-18T12:00:00.000Z","runtime":"37 min"}]}}