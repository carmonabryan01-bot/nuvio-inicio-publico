jpg","tmdbId":4771546}],"writers":[{"name":"Scott Frank","character":"Scott Frank","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/xoaCq1717lTUl89dHU4WdO1BM2L.jpg","tmdbId":2199},{"name":"Chandni Lakhani","character":"Chandni Lakhani","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/idRFUBGkpObtlAaAwhYlkxQfq3X.jpg","tmdbId":2636904},{"name":"Jussi Adler-Olsen","character":"Jussi Adler-Olsen","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/mvpzkD9bCaoAfyFDu7luQHXvXUo.jpg","tmdbId":1305379}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/jnDs84n7B7dfUzDepe0VHXXwlas.jpg","https://image.tmdb.org/t/p/w500/33cbXLBzFhw2NAzFHEE1yKLAWwJ.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt27995114:1:1","season":1,"episode":1,"title":"Episodio 1","overview":"El detective Carl Morck vuelve al trabajo tras un accidente casi mortal y se entera de que es el jefe de un nuevo departamento. Una fiscal enfrenta un día difícil en el tribunal.","thumbnail":"https://image.tmdb.org/t/p/w780/8m1qs3eJFrA4SeW37CTObGZ04PZ.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"65 min"},{"id":"tt27995114:1:2","season":1,"episode":2,"title":"Episodio 2","overview":"Mientras Carl y su nuevo asistente comienzan a investigar su primer caso sin resolver, el detective no puede evitar que sus demonios personales interfieran con su vida profesional.","thumbnail":"https://image.tmdb.org/t/p/w780/du2U1ld4UayqtCvHFsGMmSjrRrK.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"54 min"},{"id":"tt27995114:1:3","season":1,"episode":3,"title":"Episodio 3","overview":"Carl y Akram recrean el fatídico viaje en ferri cuando viajan a la isla de Mhòr. Rose, frustrada, intenta encontrar la manera de sumarse al departamento.","thumbnail":"https://image.tmdb.org/t/p/w780/x5j20wb20acf2KFkUrEp6IvqT88.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"55 min"},{"id":"tt27995114:1:4","season":1,"episode":4,"title":"Episodio 4","overview":"Rose va a la isla para averiguar lo que Carl no pudo. Akram encuentra una nota que le da un giro radical a la investigación.","thumbnail":"https://image.tmdb.org/t/p/w780/lZMkDgeByQISErb9zOcWKGGUoQq.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"55 min"},{"id":"tt27995114:1:5","season":1,"episode":5,"title":"Episodio 5","overview":"La desaparición de la fiscal se relaciona con una muerte. Una pelea en una oficina de prensa pone a Carl en los titulares. Moira va a terapia.","thumbnail":"https://image.tmdb.org/t/p/w780/5ubqFoi1V4ZXHcgLdnmJAG8xQ3a.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"54 min"},{"id":"tt27995114:1:6","season":1,"episode":6,"title":"Episodio 6","overview":"La policía detiene a un sospechoso por el tiroteo de Leith Park. Carl regresa a la escena del crimen antes de volver a perder la compostura en público.","thumbnail":"https://image.tmdb.org/t/p/w780/hYU0LOFPH6vqN5sTI1LfvP0DHkz.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"48 min"},{"id":"tt27995114:1:7","season":1,"episode":7,"title":"Episodio 7","overview":"Carl hace algunas acusaciones peligrosas ante algunos hombres poderosos, mientras que Rose adopta una nueva estrategia para descubrir más información sobre Sam Haig.","thumbnail":"https://image.tmdb.org/t/p/w780/vAkD9HbyDMLsWWijCvgvn7fl3xQ.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"52 min"},{"id":"tt27995114:1:8","season":1,"episode":8,"title":"Episodio 8","overview":"Los secuestradores le dan una pista a su víctima mientras la presionan para que responda, cueste lo que cueste. El Dept. Q está cada vez más cerca de resolver su propio enigma.","thumbnail":"https://image.tmdb.org/t/p/w780/okx56aovuWm1kkw4kjGVIkbhEQt.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"43 min"},{"id":"tt27995114:1:9","season":1,"episode":9,"title":"Episodio 9","overview":"Una vieja grabación hace encajar todas las piezas. Pero a medida que la presión aumenta ―tanto dentro como fuera de la cámara―, un interrogante acecha: ¿llegará Carl a tiempo?","thumbnail":"https://image.tmdb.org/t/p/w780/zsociJsIRIMBswesTnMnkBQVwMT.jpg","released":"2025-05-29T12:00:00.000Z","runtime":"72 min"},{"id":"tt27995114:2:1","season":2,"episode":1,"title":"Episodio 1"}]}}