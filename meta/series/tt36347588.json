mdb.org/t/p/w276_and_h350_face/glk5bE5fOixuInd8mgAl2jlojg5.jpg","tmdbId":6009552},{"name":"강찬희","character":"Kwon In-ho","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/2vBAQc9BKRAePO0NQcSp90KHMpk.jpg","tmdbId":2064247},{"name":"강명수","character":"Commander of the royal guard","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/nB9agTqlkI4e4eyAnznfGPQzYLS.jpg","tmdbId":4001822},{"name":"정기섭","character":"Left State Councillor","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/h9ihe6xJL45lECEQ2i38Xl932vf.jpg","tmdbId":139514},{"name":"채서진","character":"Mi-ok","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/tsNJXifO5xKwvfyRkpbSGJC1PHR.jpg","tmdbId":1619436},{"name":"신소현","character":"Cho Yoon [Young]","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/9vPE4zx2hmaJEplLH6j9mrSdc70.jpg","tmdbId":3339722},{"name":"정현준","character":"Cho Won [Young]","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/vZadA6ip6V2kh0VZW9RwnLcYFgW.jpg","tmdbId":2306987},{"name":"Kim Ji-an","character":"Eun-sil","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/pG6EWOuSkQPIg1LguOLeso1tWjB.jpg","tmdbId":6508758}],"directors":[{"name":"정지우","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/mQUDzhJ7IpKj9qsZTimqKFHKf91.jpg","tmdbId":97142}],"writers":[{"name":"정지우","character":"정지우","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/mQUDzhJ7IpKj9qsZTimqKFHKf91.jpg","tmdbId":97142},{"name":"안혜송","character":"안혜송","photo":null,"tmdbId":5952897},{"name":"이승영","character":"이승영","photo":null,"tmdbId":5288974},{"name":"Choderlos de Laclos","character":"Choderlos de Laclos","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/re6q4Vx56AzLDOrhDd0S8RpFDsv.jpg","tmdbId":11879}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/2ao71xKHLsyUZbwwPJ3kQdJrcH0.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt36347588:1:1","season":1,"episode":1,"title":"Episodio 1","overview":"Lady Cho enmascara su inquietud cuando Lord Yoo toma a una joven concubina como heredera. Más tarde, le escribe a su primo Cho Won con una idea.","thumbnail":"https://image.tmdb.org/t/p/w780/1XcenMmG8D3L1czlk5n6Ykstpuz.jpg","released":"2026-09-18T12:00:00.000Z","runtime":"53 min"},{"id":"tt36347588:1:2","season":1,"episode":2,"title":"Episodio 2","overview":"Lady Cho y Cho Won, el seductor más notorio de la época, comienzan un juego peligroso. Pusieron sus miras en una mujer virtuosa que tal vez no se doblegue tan fácilmente.","thumbnail":"https://image.tmdb.org/t/p/w780/1bfhLWBxXHA5Ns1KyLmlN9kBc5.jpg","released":"2026-09-18T12:00:00.000Z","runtime":"53 min"},{"id":"tt36347588:1:3","season":1,"episode":3,"title":"Episodio 3","overview":"Cho Won se acerca directamente a Hui-yeon, provocando su dolor y poniendo a prueba su fe. Luego provoca a Lady Cho con un movimiento que podría darle la ventaja.","thumbnail":"https://image.tmdb.org/t/p/w780/4C5LfhxU3EXB7y79KQG97qGLxRz.jpg","released":"2026-09-18T12:00:00.000Z","runtime":"49 min"},{"id":"tt36347588:1:4","season":1,"episode":4,"title":"Episodio 4","overview":"Cho Won once hid his longing for Lady Cho with nights spent with courtesans, yet the void remained. As he pursues Hui-yeon, his facade begins to fade.","thumbnail":"https://image.tmdb.org/t/p/w780/aA9wdj4InFlCYyOqxOxm1bsD0Qm.jpg","released":"2026-09-18T12:00:00.000Z","runtime":"48 min"},{"id":"tt36347588:1:5","season":1,"episode":5,"title":"Episodio 5","overview":"Lady Cho explota los sentimientos secretos de So-ok por otro hombre. Mientras tanto, emociones complicadas abruman a Cho Won a medida que su relación con Hui-yeon se profundiza.","thumbnail":"https://image.tmdb.org/t/p/w780/mGHwcaCHjOnk22yPG2AUdWOoFT6.jpg","released":"2026-09-18T12:00:00.000Z","runtime":"64 min"},{"id":"tt36347588:1:6","season":1,"episode":6,"title":"Episodio 6","overview":"Lady Cho advierte a Cho Won que la apuesta manchará su honor y su apellido—, pero él promete llevar adelante su peligroso juego a medida que crezcan los sentimientos.","thumbnail":"https://image.tmdb.org/t/p/w780/iKmuTbC3mehROT7mGfWwf9Tl6uU.jpg","released":"2026-09-18T12:00:00.000Z","runtime":"55 min"},{"id":"tt36347588:1:7","season":1,"episode":7,"title":"Episodio 7","overview":"Cho Won y Hui-yeon se vuelven más cercanos mientras disfrutan de un breve respiro juntos lejos de la vista del público — hasta que una orden real amenaza su paz.","thumbnail":"https://image.tmdb.org/t/p/w780/6KhuZGqXqZ9eIB8jckPqUJymAIj.jpg","released":"2026-09-18T12:00:00.000Z","runtime":"60 min"},{"id":"tt36347588:1:8","season":1,"episode":8,"title":"Episodio 8","overview":"Mientras el plan se sale de control, Lady Cho se enfrenta a un ajuste de cuentas con Cho Won y Hui-yeon. ¿Hasta dónde llegará para llevar su plan hasta el final?","thumbnail":"https://image.tmdb.org/t/p/w780/x0HHyKiJzfYjbWr4E28Z7JSHoSO.jpg","released":"2026-09-18T12:00:00.000Z","runtime":"80 min"}]}}