db.com/banners/v4/episode/11524617/screencap/6973a88ef042d.jpg","released":"2026-01-27T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:1:5","season":1,"episode":5,"title":"5. Fui a una expedición","overview":"Sei pensaba aprovechar su tiempo en el banquete, pero un anuncio alterará sus planes y preocupará a Aresh.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11524618/screencap/697c970ecd170.jpg","released":"2026-02-03T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:1:6","season":1,"episode":6,"title":"6. Hice una propuesta","overview":"Acabada la expedición, Kondou pone en marcha un elaborado plan que remecerá los cimientos mismos del reino.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11524619/screencap/6986039d9e21e.jpg","released":"2026-02-10T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:1:7","season":1,"episode":7,"title":"7. Fui en comisión de servicio","overview":"Junto a una inesperada mudanza, Seiichirou comienza una inspección a la iglesia, para molestia del capitán.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11524620/screencap/699012b26dbc4.jpg","released":"2026-02-17T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:1:8","season":1,"episode":8,"title":"8. Fui a trabajar en mi día libre","overview":"Sei continúa averiguando sobre la iglesia. Sin embargo, en palacio todos parecen querer pedirle consejo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11524621/screencap/6998261c000d6.jpg","released":"2026-02-24T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:1:9","season":1,"episode":9,"title":"9. Ideé un plan","overview":"Una idea de Yua le viene como anillo al dedo a Sei y abre nuevos horizontes previo a la última expedición.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11524622/screencap/69a162aded1de.jpg","released":"2026-03-03T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:1:10","season":1,"episode":10,"title":"10. Me puse a investigar","overview":"Kondou consigue patrocinador para las clases. No obstante, hay algo en la iglesia que le da muy mala espina.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11524623/screencap/69aaa2a452fc6.jpg","released":"2026-03-10T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:1:11","season":1,"episode":11,"title":"11. Me hospitalizaron","overview":"Aresh llega al extremo para salvar a Sei, quien deberá meditar sobre su actitud, sospechas y sentimientos.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11524624/screencap/69b3d5d6b71a6.jpg","released":"2026-03-17T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:1:12","season":1,"episode":12,"title":"12. Lo acorralé. Y después…","overview":"Seiichirou juega todas sus cartas para desenmascarar al culpable y enfrentar por fin a su propio corazón.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11524625/screencap/69bd52b53d751.jpg","released":"2026-03-24T12:00:00.000Z","runtime":"24 min"},{"id":"tt38652044:0:1","season":0,"episode":1,"title":"I Let My Thoughts Wander","overview":"Five days after moving in with Aresh, Kondou comes across a curious magic tool that looks like a kaleidoscope.","released":"2026-05-27T12:00:00.000Z","runtime":"24 min"}]}}