org/t/p/w780/7TLO4rPtAd1uPjeA1CC42aUaEcp.jpg","released":"2025-02-12T12:00:00.000Z","runtime":"51 min"},{"id":"tt31186958:1:6","season":1,"episode":6,"title":"El último eslabón","overview":"Mientras la NSA observa todos sus movimientos, Taylah y Ed se apresuran a rastrear la última pieza del rompecabezas.","thumbnail":"https://image.tmdb.org/t/p/w780/rqD7lGZ2psavIdY1Pkr42OBgQX0.jpg","released":"2025-02-19T12:00:00.000Z","runtime":"44 min"},{"id":"tt31186958:1:7","season":1,"episode":7,"title":"El buscador de primos","overview":"Ed, se ve obligado a terminar su trabajo. Taylah debe tomar una decisión importante. Un aliado queda atrapado en medio del caos.","thumbnail":"https://image.tmdb.org/t/p/w780/3MNy591CcZBlrVIxNuMkuIYcmMY.jpg","released":"2025-02-26T12:00:00.000Z","runtime":"58 min"},{"id":"tt31186958:1:8","season":1,"episode":8,"title":"La llave","overview":"Mientras Ed y Taylah intentan exponer la verdad, descubren que una amenaza mortal está más cerca de lo que se hubieran imaginado.","thumbnail":"https://image.tmdb.org/t/p/w780/cUcvx7KTBCXkS8yXk5Jp95nkV4S.jpg","released":"2025-03-05T12:00:00.000Z","runtime":"52 min"}]}}