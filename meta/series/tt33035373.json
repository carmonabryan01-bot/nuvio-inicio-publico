ace/u5mv4EiIl5oS2s0yUaqtjbpWEz2.jpg","tmdbId":937317}],"writers":[{"name":"William Oldroyd","character":"William Oldroyd","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/e3cJeIVKozF9tCPfGoJVi066VTO.jpg","tmdbId":1661862},{"name":"Alice Feeney","character":"Alice Feeney","photo":null,"tmdbId":4847534}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/cDSXLVQLkCSBIpBx3UW04TsfZ5c.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt33035373:1:1","season":1,"episode":1,"title":"Episodio 1","overview":"Anna, una presentadora de noticias, regresa a su pueblo natal de Georgia para cubrir un homicidio. Nada es lo que parece, y el principal investigador del caso es su exesposo...","thumbnail":"https://image.tmdb.org/t/p/w780/fJjdHdLMdx9hM20hQU5XAHMtpvY.jpg","released":"2026-01-08T12:00:00.000Z","runtime":"47 min"},{"id":"tt33035373:1:2","season":1,"episode":2,"title":"Episodio 2","overview":"Jack y Priya buscan fallas en la coartada del sospechoso clave. Anna regresa a su escuela para entrevistar a la directora, pero el encuentro se torna agresivo.","thumbnail":"https://image.tmdb.org/t/p/w780/dTYoHapJoPmAYYfA6vXEHuTcTEE.jpg","released":"2026-01-08T12:00:00.000Z","runtime":"44 min"},{"id":"tt33035373:1:3","season":1,"episode":3,"title":"Episodio 3","overview":"Anna no duda en lanzarse de vuelta a su antiguo puesto. Zoe confronta a Jack por los oscuros secretos que esconde. El estado de salud de Alice obliga a entablar charlas difíciles.","thumbnail":"https://image.tmdb.org/t/p/w780/sfxcPyZzPEpZLAI9tiN2P6te2qd.jpg","released":"2026-01-08T12:00:00.000Z","runtime":"41 min"},{"id":"tt33035373:1:4","season":1,"episode":4,"title":"Episodio 4","overview":"Jack lucha por aplacar las tensiones de los locales en una encendida reunión. Las sospechas de Priya se confirman, y el dolor de los recuerdos atormenta a Anna.","thumbnail":"https://image.tmdb.org/t/p/w780/2fJzyBF7QFJFMVI9XT7fw2Tv9Vt.jpg","released":"2026-01-08T12:00:00.000Z","runtime":"48 min"},{"id":"tt33035373:1:5","season":1,"episode":5,"title":"Episodio 5","overview":"Jack, acorralado, empieza a actuar de manera errática. Anna cambia de roles en una entrevista, y el pasado de Richard sale a la luz.","thumbnail":"https://image.tmdb.org/t/p/w780/a5Yw9mxR4ex2yjHLelS1jEQnYYt.jpg","released":"2026-01-08T12:00:00.000Z","runtime":"45 min"},{"id":"tt33035373:1:6","season":1,"episode":6,"title":"Episodio 6","overview":"Mientras el caso va llegando a su resolución, Jack y Anna deben enfrentar los pecados del pasado... y sus brutales consecuencias en el presente.","thumbnail":"https://image.tmdb.org/t/p/w780/iw6hFVQ8ItYOGS4excmauXnyEI5.jpg","released":"2026-01-08T12:00:00.000Z","runtime":"40 min"}]}}