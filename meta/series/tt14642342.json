or/8747888/photo/61179033cfe50.jpg","tmdbId":3142707},{"name":"Ai Kakuma","character":"Aki","photo":"https://artworks.thetvdb.com/banners/v4/actor/460210/photo/61179151687df.jpg","tmdbId":1324646},{"name":"尾崎由香","character":"Kossetsu","photo":"https://artworks.thetvdb.com/banners/v4/actor/486798/photo/614cbffc466d7.jpg","tmdbId":1950471},{"name":"引坂理絵","character":"Hime","photo":"https://artworks.thetvdb.com/banners/v4/actor/614665/photo/614cba4042c80.jpg","tmdbId":2019928},{"name":"遊佐浩二","character":"War","photo":"https://artworks.thetvdb.com/banners/v4/actor/7864374/photo/614cbae821887.jpg","tmdbId":555099},{"name":"長谷川芳明","character":"Koumori-senpai","photo":"https://artworks.thetvdb.com/banners/v4/actor/7888295/photo/614cb74eeb2a5.jpg","tmdbId":1717125},{"name":"松野太紀","character":"Futatsuboshi","photo":"https://artworks.thetvdb.com/banners/v4/actor/313248/photo/6147006431849.jpg","tmdbId":1222055},{"name":"竹達彩奈","character":"Kodama","photo":"https://artworks.thetvdb.com/banners/v4/actor/302377/photo/6147011c29836.jpg","tmdbId":1072776},{"name":"中島卓也","character":"Susugashira","photo":"https://artworks.thetvdb.com/banners/v4/actor/8176899/photo/614cb8b1bbefc.jpg","tmdbId":2734574},{"name":"大川透","character":"Voice","photo":"https://artworks.thetvdb.com/banners/v4/actor/7864370/photo/614cb5cd96221.jpg","tmdbId":9719},{"name":"古川慎","character":"Sou Seiji","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/inLmBZhrqXeE9wlViyK28ocKJSw.jpg","tmdbId":1319218},{"name":"島田敏","character":"Tora","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/5jJgMyFAP3GgQtFxP2qe0oE4LHk.jpg","tmdbId":115790},{"name":"園崎未恵","character":"President","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/iYnpn1e7Ba1oMK8ZdgAvqzxng9e.jpg","tmdbId":210350},{"name":"拝真之介","character":"Okujiri","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/69w6vPB1Dqq7lnmZWODKgc8uKFE.jpg","tmdbId":1981445},{"name":"榊原優希","character":"Tazawa","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/4Jj08itCNpPrN1Sr3uv26h1p740.jpg","tmdbId":2864258}],"writers":[{"name":"夏目真悟","character":"夏目真悟","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/jkrKdmxG7H7DFh9LchDhZFAmYOD.jpg","tmdbId":1509979}],"certification":"TV-14","seasonPosters":["https://image.tmdb.org/t/p/w500/6sJ7FCtxzrNfgM70s2d7VS0Xjdm.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt14642342:1:1","season":1,"episode":1,"title":"1. La isla al final del verano","overview":"\r\nA mitad de las vacaciones de verano, 36 estudiantes, algunos con superpoderes recién descubiertos, se encuentran solos en su escuela secundaria, a la deriva en un vacío negro, incapaces de contactar con el mundo exterior. Algunos estudiantes intentan imponer orden, pero se enfrentan a la oposición.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8396530/screencap/60cf3b356f1a5.jpg","released":"2021-07-16T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:2","season":1,"episode":2,"title":"2. Extraterrestres","overview":"\r\nLos estudiantes se han mudado a una isla cercana, donde no tienen escasez de comida y pueden obtener lo que quieran a través del poder de Mizuho. De repente, comienzan a estallar incendios inexplicables y comienza la búsqueda para descubrir quién o qué los está causando.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499086/screencap/60f9ac18cf98f.jpg","released":"2021-07-23T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:3","season":1,"episode":3,"title":"3. El gato que usa sandalias","overview":"\r\nNagara, Nozomi, Asakaze y Rajdhani continúan buscando nuevos mundos. Los estudiantes comienzan a desaparecer y sus cuerpos se encuentran \"congelados\" en conchas negras, por lo que Pony le pide a Mizuho que investigue el asunto. Mizuho revela una sorpresa sobre su poder a Nagara.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499087/screencap/6104387428da8.jpg","released":"2021-07-30T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:4","season":1,"episode":4,"title":"4. El gran mono de béisbol","overview":"Mientras los náufragos nadan en un misterioso sumidero, parecen ser llevados momentáneamente a casa. Cap invita a Nagara a practicar béisbol con él, lo que le lleva a contar sobre la Liga de los Monos y cómo su lanzador estrella, Blue, se perdió un juego perfecto.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499088/screencap/610c2ce31b083.jpg","released":"2021-08-06T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:5","season":1,"episode":5,"title":"5. Saltando aulas","overview":"\r\nNagara y sus amigos usan su poder para explorar nuevos mundos en un esfuerzo por regresar a casa. Mientras tanto, los otros estudiantes discuten la bomba de la Sra. Aki de que algunos estudiantes pudieron usar sus poderes de antemano, y eso puede ser lo que los dejó a la deriva.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499089/screencap/6115637b93b9d.jpg","released":"2021-08-13T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:6","season":1,"episode":6,"title":"6. El largo adiós","overview":"\r\nNagara y Rajdhani llegan a un mundo llamado \"Cineasta\" y descubren una película filmada en su totalidad desde el punto de vista de Nagara. Mizuho descubre un perro callejero llamado Yamabiko, que dice ser otro náufrago que asistió a la misma escuela que los otros estudiantes.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499090/screencap/611edf2b612bd.jpg","released":"2021-08-20T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:7","season":1,"episode":7,"title":"7. Libro de ruta","overview":"\r\nHabiendo aprendido la verdad sobre Este mundo, los grupos dirigidos por la Sra. Aki y Hoshi se preparan para ir por caminos separados. Nagara se encuentra en un mundo al revés del que no puede salir libremente y se ve obligado a trabajar en la construcción de una Torre de Babel que se extiende hacia abajo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499091/screencap/6127d4de4cf53.jpg","released":"2021-08-27T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:8","season":1,"episode":8,"title":"8. Perro riendo","overview":"\r\nMientras viaja por el desierto, Mizuho le pregunta a Yamabiko cómo se convirtió en un perro. Yamabiko luego relata cómo, hace 5000 años, vagó por diferentes mundos solo, hasta que conoció a una chica a la que poco a poco le abrió el corazón, pero su felicidad duró poco.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499092/screencap/6132155a11f79.jpg","released":"2021-09-03T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:9","season":1,"episode":9,"title":"9. Este chazuke de salmón, olvidé el salmón","overview":"\r\nEn un vasto páramo congelado, los gemelos Sou y Seiji han estado luchando entre sí durante milenios. La Sra. Aki dice que para cambiar el mundo, necesitan el poder \"inverso\" de los gemelos, y Nagara y Mizuho vienen a ayudar. Yamabiko interroga a Sakura, uno de los gatos de Mizuho.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499093/screencap/613bad7c819f3.jpg","released":"2021-09-10T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:10","season":1,"episode":10,"title":"10. Verano y el Demonio","overview":"Kossetsu lee las mentes de los demás que pasan por el mundo de una estación de tren usando su verdadero poder. Ella suspira por Asakaze, sabiendo que él está interesado en Nozomi, y que Nozomi es la única que puede cambiarlo. Asakaze recibe una tarea que cambiará el mundo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499094/screencap/6143e6c4a0500.jpg","released":"2021-09-17T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:11","season":1,"episode":11,"title":"11. El Joven y el Mar","overview":"Después de enterarse de la muerte de Nozomi por la carta de Kossetsu, Nagara y Mizuho realizan una ceremonia en su honor. A medida que avanzan en el proyecto de volver a casa, son visitados por un viejo amigo, quien les cuenta la historia de cuando conoció al hombre que inventó la muerte.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499095/screencap/614cc75112af3.jpg","released":"2021-09-24T12:00:00.000Z","runtime":"24 min"},{"id":"tt14642342:1:12","season":1,"episode":12,"title":"12. Un receso de dos años","overview":"\r\nNagara asiste a la ceremonia de inauguración de su escuela técnica, pero se siente fuera de lugar. Él ve a Mizuho dejando su escuela de niñas, pero ella lo ignora. Recuerda lo que sucedió después de despegar al espacio, y se preguntó si alguna vez se fue a la deriva.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/8499096/screencap/6155fe0917fc3.jpg","released":"2021-10-01T12:00:00.000Z","runtime":"24 min"}]}}