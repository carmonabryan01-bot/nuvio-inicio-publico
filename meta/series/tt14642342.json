{"meta":{"id":"tt14642342","type":"series","name":"Sonny Boy","imdb_id":"tt14642342","description":"Son unas vacaciones de verano ordinarias... excepto por el hecho de que el instituto de Nagara se ha trasladado a otra dimensión y sus compañeros están desarrollando poderes.","poster":"https://btttr.cc/poster-q/imdb/poster-default/tt14642342.jpg?tag=none&lang=es-MX&rs=IM","background":"https://image.tmdb.org/t/p/original/rgmBS8zkk6RrGUOdWqzZs8hjZer.jpg","logo":"https://image.tmdb.org/t/p/original/68AWgEgN3uQ3JA3ClzhcowMJGTK.png","genres":["Animación","Drama","Misterio","Sci-Fi & Fantasy"],"releaseInfo":"2021","released":"2021-07-16T12:00:00.000Z","status":"Ended","runtime":"24 min","imdbRating":"7.7","country":"Japan","cast":["市川蒼","大西沙織","悠木碧","小林千晃","後藤ヒロキ","津田健次郎","内藤有海","佐藤はな","上田燿司","山本祥太","荻野佳奈","Ai Kakuma","尾崎由香","引坂理絵","遊佐浩二","長谷川芳明","松野太紀","竹達彩奈","中島卓也","大川透","古川慎","島田敏","園崎未恵","拝真之介","榊原優希"],"writer":["夏目真悟"],"trailers":[{"source":"k20G56e3OvM","type":"Trailer","name":"Official Anime PV 2","ytId":"k20G56e3OvM","lang":"en"}],"trailerStreams":[{"ytId":"k20G56e3OvM","title":"Official Anime PV 2"}],"links":[{"name":"7.7","category":"imdb","url":"https://imdb.com/title/tt14642342"},{"name":"Animación","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Animaci%C3%B3n"},{"name":"Drama","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Drama"},{"name":"Misterio","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Misterio"},{"name":"Sci-Fi & Fantasy","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Sci-Fi+%26+Fantasy"},{"name":"市川蒼","category":"Cast","url":"stremio:///search?search=%E5%B8%82%E5%B7%9D%E8%92%BC"},{"name":"大西沙織","category":"Cast","url":"stremio:///search?search=%E5%A4%A7%E8%A5%BF%E6%B2%99%E7%B9%94"