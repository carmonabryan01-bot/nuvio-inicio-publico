149275},{"name":"안상우","character":"Ma Hee-do","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/dHjTMijiOfJ9TH5QfdtwoC5d3PQ.jpg","tmdbId":2037462},{"name":"최진호","character":"Yoon Tae-sik","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/pl5qsHEGH9beFQwNUXMLYGgn17J.jpg","tmdbId":127848},{"name":"홍은희","character":"Yoon Mi-jin","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/r6ZSTldUMUSmkUiaUEysHVpTHAp.jpg","tmdbId":1253559},{"name":"박아인","character":"Yoon Na-jeong","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/ox6FlVKrHHp0Ndr7SAADtEYySEC.jpg","tmdbId":2184678},{"name":"조승연","character":"Na Man-seok","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/7giNY3F4YG5n8HUsICdcTu0Ftkz.jpg","tmdbId":73252},{"name":"이영준","character":"Moon Joon-hyeon","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/1BYc0ofvfsMD7qatMM5EDBAE8Km.jpg","tmdbId":5102483},{"name":"전영","character":"Choi Myeong-sook","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/pGbpvdY11IjUCXnDj7FZI6uCZ6a.jpg","tmdbId":3925276},{"name":"소이한","character":"Han Eun-ho","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/mOyTQubWVQHHpRasNt0JiyrWJNe.jpg","tmdbId":6014534}],"directors":[{"name":"박단희","photo":null,"tmdbId":3124179}],"writers":[{"name":"문수정","character":"문수정","photo":null,"tmdbId":6060703},{"name":"이아현","character":"이아현","photo":null,"tmdbId":6060707},{"name":"류도하","character":"류도하","photo":null,"tmdbId":6060708}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/I91Lf9144zcXXpTsKrEuGCq3nt.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt45246384:1:1","season":1,"episode":1,"title":"Episodio 1","overview":"Taekang Group's successor, Yoon Yi-jun, is suspected of murdering his secretary, but the group's power and lack of evidence impede the investigation. To find key evidence, special forces-turned-detective Kang Jae-hee applies to be his secretary, not as a woman but as a man! She manages to get the job, but Yi-jun doesn't let his guard down. Jae-hee risks getting exposed on her first day at work.","thumbnail":"https://image.tmdb.org/t/p/w780/6JkbieDMvBtckrzHupTr27tJcs0.jpg","released":"2026-10-19T12:00:00.000Z","runtime":"64 min"},{"id":"tt45246384:1:2","season":1,"episode":2,"title":"Episodio 2","overview":"Kang Jae-hee's double life begins. She's Yoon Yi-jun's secretary by day and a detective by night. Yi-jun keeps testing her, but Jae-hee relentlessly keeps an eye on him and searches for the missing phone. She plans to infiltrate the room that's banned from entering, but Yi-jun doesn't let his guard down easily. Their relationship takes a strange turn through unexpected physical contact.","thumbnail":"https://image.tmdb.org/t/p/w780/7kKgUbLttXSDrM6uVccHQua9W9w.jpg","released":"2026-10-20T12:00:00.000Z","runtime":"64 min"},{"id":"tt45246384:1:3","season":1,"episode":3,"title":"Episodio 3","overview":"Yi-jun stays prickly but starts trusting Jae-hee. Jae-hee notices something suspicious about the milk Yi-jun was drinking and realizes he is being threatened. The investigating team thinks the perpetrator could be someone else. Jae-hee finally gets the chance to enter the room that's been banned from entering. She searches for the missing phone in the room but immediately faces danger.","thumbnail":"https://image.tmdb.org/t/p/w780/h4PWl2JBGPKaZWH9I8WaKa6RznQ.jpg","released":"2026-10-26T12:00:00.000Z","runtime":"61 min"},{"id":"tt45246384:1:4","season":1,"episode":4,"title":"Episodio 4","overview":"The investigating team finds traces of herbicide in the milk and suspects that someone is after Yi-jun. Jae-hee keeps an eye on Yoon Na-jung, the ambitious second daughter of Taekang, and follows Yi-jun to the family dinner, which is full of tension. Chairman Yoon makes an unexpected decision, causing a stir. Jae-hee joins Yi-jun for a drink and her drinking habit starts coming out.","thumbnail":"https://image.tmdb.org/t/p/w780/cKrQHvI27Xsxr4jEDr62Ed7LHNh.jpg","released":"2026-10-27T12:00:00.000Z","runtime":"65 min"},{"id":"tt45246384:1:5","season":1,"episode":5,"title":"Episodio 5","overview":"Jae-hee can't remember what happened the previous night and is anxious if Yi-jun is crabby because he got wind of her true identity while drunk. What's worse, Yi-jun's fiancée, Lee Si-a, returns from France. Yi-jun feels confused but stays cold toward Jae-hee, and Jae-hee is upset when Yi-jun goes to have dinner with Si-a. After much searching, Jae-hee finally gets hold of the key evidence.","thumbnail":"https://image.tmdb.org/t/p/w780/sRBqhNkVNWFE1eOR5pCZtgjGZiJ.jpg","released":"2026-11-02T12:00:00.000Z","runtime":"60 min"},{"id":"tt45246384:1:6","season":1,"episode":6,"title":"Episodio 6","overview":"Yi-jun kisses Jae-hee but insists that he sees Jae-hee as a little brother and continues to nitpick. Meanwhile, the investigating team summons Hye-jung as a witness, shocking Yi-jun and Si-hyun. To make matters worse, Chairman Yoon is putting pressure on Yi-jun as well. Overwhelmed by the pressure and confusion, Yi-jun pushes away Jae-hee, who eventually has enough and says she will quit.","thumbnail":"https://image.tmdb.org/t/p/w780/mjqMPiSBZBXmdYY9CjLLku3s01N.jpg","released":"2026-11-03T12:00:00.000Z","runtime":"64 min"},{"id":"tt45246384:1:7","season":1,"episode":7,"title":"Episodio 7","released":"2026-11-09T12:00:00.000Z"},{"id":"tt45246384:1:8","season":1,"episode":8,"title":"Episodio 8","released":"2026-11-10T12:00:00.000Z"},{"id":"tt45246384:1:9","season":1,"episode":9,"title":"Episodio 9","released":"2026-11-16T12:00:00.000Z"},{"id":"tt45246384:1:10","season":1,"episode":10,"title":"Episodio 10","released":"2026-11-17T12:00:00.000Z"},{"id":"tt45246384:1:11","season":1,"episode":11,"title":"Episodio 11","released":"2026-11-23T12:00:00.000Z"},{"id":"tt45246384:1:12","season":1,"episode":12,"title":"Episodio 12","released":"2026-11-24T12:00:00.000Z"}]}}