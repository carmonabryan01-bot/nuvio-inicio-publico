ased":"2024-11-21T12:00:00.000Z","runtime":"25 min"},{"id":"tt32581509:1:4","season":1,"episode":4,"title":"Máscara","overview":"Tras enterarse de que Antinarcóticos tiene los grandes eventos en el punto de mira, Kai roba una moto para ir a un concierto en busca de Ayumi... ¿Logrará que no la detengan?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10817784/screencap/67575748352c2.jpg","released":"2024-11-21T12:00:00.000Z","runtime":"24 min"},{"id":"tt32581509:1:5","season":1,"episode":5,"title":"Brújula","overview":"La tensión se dispara en la sala de espera del hospital cuando Kageyama aparece con Yukio exigiendo la cooperación del Taller Suma para encontrar a un traidor.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10817787/screencap/67575771a851b.jpg","released":"2024-11-21T12:00:00.000Z","runtime":"24 min"},{"id":"tt32581509:1:6","season":1,"episode":6,"title":"Tokio","overview":"Spoke y Watari unen fuerzas y recorren la ciudad en busca de información mientras Hugo y Kai emprenden una carrera contrarreloj para entregar las pruebas.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10817789/screencap/675757ca043c6.jpg","released":"2024-11-21T12:00:00.000Z","runtime":"26 min"}]}}