o8g5SXProdSd2gKWOOa6Ph5Gwqh.jpg","tmdbId":3868775},{"name":"Evan Vincent Washington","character":"Evan Vincent Washington","photo":null,"tmdbId":4053189}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/7AS4WGGA8COAPgES3arizDOtfWf.jpg",null]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt36022742:1:1","season":1,"episode":1,"title":"Ya era hora","overview":"Cuando un grupo de delincuentes lleva a cabo un atrevido robo durante Halloween, el detective angelino Isaiah Stiles intuye que no se trata de un crimen aislado.","thumbnail":"https://image.tmdb.org/t/p/w780/9bBErTKznFs6r7uoeakR1FCKgC8.jpg","released":"2026-05-14T12:00:00.000Z","runtime":"56 min"},{"id":"tt36022742:1:2","season":1,"episode":2,"title":"Rompiendo el protocolo","overview":"Stiles reúne un grupo especial para investigar los robos recientes. Con los policías de Los Ángeles en alerta, Coltrane se propone atar cabos sueltos.","thumbnail":"https://image.tmdb.org/t/p/w780/sfczhnUO4SIKn7x3WoZSUtQgY79.jpg","released":"2026-05-14T12:00:00.000Z","runtime":"57 min"},{"id":"tt36022742:1:3","season":1,"episode":3,"title":"Cara a cara","overview":"Stiles, convencido de haber identificado al cabecilla de la banda, intenta conseguir pruebas contundentes. Charlie insta a Ebony a que tome precauciones.","thumbnail":"https://image.tmdb.org/t/p/w780/5BeGLytmnnfjDJI41bDqk9x2gbt.jpg","released":"2026-05-14T12:00:00.000Z","runtime":"60 min"},{"id":"tt36022742:1:4","season":1,"episode":4,"title":"Fue un buen día","overview":"El equipo de Coltrane acepta el encargo peligroso de un cliente volátil. Stiles presiona a un sospechoso clave. Candace se apoya en Ebony.","thumbnail":"https://image.tmdb.org/t/p/w780/ytr5DJjqecxte1guyMrXtN4xocj.jpg","released":"2026-05-14T12:00:00.000Z","runtime":"63 min"},{"id":"tt36022742:1:5","season":1,"episode":5,"title":"Solo negocios. Nada personal","overview":"Stiles, envalentonado por un avance en el caso, da un golpe al corazón de la casa de los Wilder. Coltrane idea una retorcida estrategia para cobrarse revancha.","thumbnail":"https://image.tmdb.org/t/p/w780/Apny6L32d2iv1RqTjfkbbItUcNh.jpg","released":"2026-05-14T12:00:00.000Z","runtime":"56 min"},{"id":"tt36022742:1:6","season":1,"episode":6,"title":"La suerte está echada","overview":"Stiles y Coltrane tienen un enfrentamiento explosivo. Un doloroso descubrimiento lleva a Stiles a perseguir un nuevo objetivo.","thumbnail":"https://image.tmdb.org/t/p/w780/4jmJJgTUy3J8cN28fi0D0wjMz2h.jpg","released":"2026-05-14T12:00:00.000Z","runtime":"56 min"},{"id":"tt36022742:1:7","season":1,"episode":7,"title":"Repercusiones","overview":"Un hecho violento que involucra a Isaiah —y a Noah— sacude a la familia Stiles. Harta de quedar al margen, Ebony toma cartas en el asunto.","thumbnail":"https://image.tmdb.org/t/p/w780/5IlLXIwXzpPBZi2LgTU2tEbWJzd.jpg","released":"2026-05-14T12:00:00.000Z","runtime":"56 min"},{"id":"tt36022742:1:8","season":1,"episode":8,"title":"Zugzwang","overview":"Coltrane, que se queda sin opciones, idea un audaz plan de extracción. Stiles hace un esfuerzo desesperado por acorralar a su adversario de una vez por todas.","thumbnail":"https://image.tmdb.org/t/p/w780/dNxVLiKpXJFGbILPirUj9gbWHB0.jpg","released":"2026-05-14T12:00:00.000Z","runtime":"58 min"},{"id":"tt36022742:2:1","season":2,"episode":1,"title":"Episodio 1","released":"2027-11-19T12:00:00.000Z","runtime":"56 min"}]}}