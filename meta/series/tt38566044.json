{"meta":{"id":"tt38566044","type":"series","name":"PRI: Crónica del Fin","imdb_id":"tt38566044","description":"La muerte del PRI: una caída mil veces anunciada. Corrupción, traiciones y asesinatos marcaron su debacle. De los delirios de poder de López Portillo al derrumbe con Peña Nieto, el PRI pasó de tenerlo todo a ser un cascarón vacío.","poster":"https://btttr.cc/poster-q/imdb/poster-default/tt38566044.jpg?tag=none&lang=es-MX&rs=IM","background":"https://image.tmdb.org/t/p/original/qZXgLBCDLPmmppMmolPj4V5SkjI.jpg","genres":["Documental"],"releaseInfo":"2025","released":"2025-09-22T12:00:00.000Z","status":"Ended","runtime":"60 min","imdbRating":"7.8","country":"Mexico","cast":["Carlos Salinas de Gortari","Enrique Peña Nieto","Vicente Fox","Elba Esther Gordillo","Cuauhtémoc Cárdenas Solórzano","Porfirio Muñoz Ledo","Alejandro Moreno","Aurelio Nuño"],"director":["Denise Maerker Salmón"],"writer":["Denise Maerker Salmón"],"trailers":[{"source":"nj_mFZm3Dcw","type":"Trailer","name":"PRI: Crónica del Fin - N+ Docs","ytId":"nj_mFZm3Dcw","lang":"en"}],"trailerStreams":[{"ytId":"nj_mFZm3Dcw","title":"PRI: Crónica del Fin - N+ Docs"}],"links":[{"name":"7.8","category":"imdb","url":"https://imdb.com/title/tt38566044"},{"name":"Documental","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Documental"},{"name":"Carlos Salinas de Gortari","category":"Cast","url":"stremio:///search?search=Carlos%20Salinas%20de%20Gortari"},{"name":"Enrique Peña Nieto","category":"Cast","url":"stremio:///search?search=Enrique%20Pe%C3%B1a%20Nieto"},{"name":"Vicente Fox","category":"Cast","url":"stremio:///search?search=Vicente%20Fox"},{"name":"Elba Esther Gordillo","category":"Cast","url":"stremio:///search?search=Elba%20Esther%20Gordillo"},{"name":"Cuauhtémoc Cárdenas Solórzano","category":"Cast","url":"stremio:///search?search=Cuauht%C3%A9moc%20C%C3%A1rdenas%20Sol%C3%B3rzano"},{"name":"Porfirio Muñoz Ledo","category":"Cast","url":