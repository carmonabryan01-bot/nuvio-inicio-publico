{"meta":{"id":"tt23148340","type":"series","name":"Crystal Lake","imdb_id":"tt23148340","description":"Pam Voorhees, madre soltera, no ha podido superar el dolor tras la trágica muerte por ahogamiento de su hijo pequeño y enfermizo, Jason, en el lago del pueblo hace casi un año. Cuando dos desconocidos llegan a su casa indagando en su pasado, se desencadena una inquietante cadena de acontecimientos que deja a los habitantes de Crystal Lake preguntándose: ¿quién es realmente Pam Voorhees?","poster":"https://btttr.cc/poster-q/imdb/poster-default/tt23148340.jpg?tag=none&lang=es-MX&rs=IM","background":"https://image.tmdb.org/t/p/original/wxiBsKFEOOFK8eQStWOykNORlXY.jpg","logo":"https://image.tmdb.org/t/p/original/zMdL06gtSVXZYzZ5HomCFpCxjW7.png","genres":["Drama","Misterio"],"releaseInfo":"2026-","released":"2026-10-15T12:00:00.000Z","status":"Returning Series","imdbRating":"7.6","country":"United States of America","cast":["Linda Cardellini","William Catlett","Gwendolyn Sundstrom","Cameron Scoggins","Devin Kessler"],"writer":["Brad Caleb Kane"],"trailers":[{"source":"EpF04oGqf9k","type":"Trailer","name":"Crystal Lake: El Origen de Pamela Voorhees | Tráiler Oficial | UNIVERSAL+","ytId":"EpF04oGqf9k","lang":"es"},{"source":"kyJsEXCk_wg","type":"Trailer","name":"Tráiler Oficial en español","ytId":"kyJsEXCk_wg","lang":"es"},{"source":"Rs49eRHFD9c","type":"Trailer","name":"Official Trailer","ytId":"Rs49eRHFD9c","lang":"en"}],"trailerStreams":[{"ytId":"EpF04oGqf9k","title":"Crystal Lake: El Origen de Pamela Voorhees | Tráiler Oficial | UNIVERSAL+"},{"ytId":"kyJsEXCk_wg","title":"Tráiler Oficial en español"},{"ytId":"Rs49eRHFD9c","title":"Official Trailer"}],"links":[{"name":"7.6","category":"imdb","url":"https://imdb.com/title/tt23148340"},{"name":"Drama","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io%2Fmanifest.json/series/top?genre=Drama"},{"name":"Misterio","category":"Genres","url":"stremio:///discover/https%3A%2F%2Fv3-cinemeta.strem.io