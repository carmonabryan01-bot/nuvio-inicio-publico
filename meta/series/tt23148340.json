.tmdb.org/t/p/w780/nvYx1pBoREyWyZ8x8NEm5YsWxwC.jpg","released":"2026-10-15T12:00:00.000Z","runtime":"52 min"},{"id":"tt23148340:1:8","season":1,"episode":8,"title":"The Final Chapter","overview":"Elias arrives in Crystal Lake determined to find his family; Levon and Elias have a heated clash.","thumbnail":"https://image.tmdb.org/t/p/w780/9Jm0NFm1FtfXHbSB7k2Kra8IPMH.jpg","released":"2026-10-15T12:00:00.000Z","runtime":"43 min"}]}}