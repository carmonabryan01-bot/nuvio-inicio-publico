duledVideos":true},"videos":[{"id":"tt33332385:1:1","season":1,"episode":1,"title":"¡Bienvenidos a Widow's Bay!","overview":"¡Esperamos que hayas disfrutado las tres horas en ferry hacia el secreto mejor guardado de Nueva Inglaterra! Ignora las advertencias sobre la niebla, todo estará bien.","thumbnail":"https://image.tmdb.org/t/p/w780/ozsXKu0NRccykQd4i3QTbeL6loJ.jpg","released":"2026-04-28T12:00:00.000Z","runtime":"42 min"},{"id":"tt33332385:1:2","season":1,"episode":2,"title":"Hospedaje","overview":"Atesora el encanto histórico de nuestro mesón local, donde el alcalde Loftis probará que es seguro, pasando una noche ahí, él solo.","thumbnail":"https://image.tmdb.org/t/p/w780/vB37UqlmHX8zS4VwxHiNcQSg56E.jpg","released":"2026-04-28T12:00:00.000Z","runtime":"37 min"},{"id":"tt33332385:1:3","season":1,"episode":3,"title":"El chapuzón inaugural","overview":"Llegó la hora de la apertura anual de la playa. Coloca tu toalla mientras el alcalde “prueba las aguas”. En otro tema, no subas extraños a tu auto.","thumbnail":"https://image.tmdb.org/t/p/w780/ijNpTshFRrdkWLACZRuIwrJULYk.jpg","released":"2026-05-05T12:00:00.000Z","runtime":"38 min"},{"id":"tt33332385:1:4","season":1,"episode":4,"title":"Lecturas en la playa","overview":"¡Asegúrate de empacar una buena lectura para la playa! (En esta isla no recomendamos libros de autoayuda).","thumbnail":"https://image.tmdb.org/t/p/w780/40BkHxHlqEvofdchhuffdyFdY8D.jpg","released":"2026-05-12T12:00:00.000Z","runtime":"36 min"},{"id":"tt33332385:1:5","season":1,"episode":5,"title":"¿Qué esperar en tu viaje?","overview":"Nos disculpamos por el toque de queda. Por favor, permanece en calma mientras determinamos qué está pasando. Nota: No permitas salir a tus adolescentes después de oscurecer.","thumbnail":"https://image.tmdb.org/t/p/w780/ntWIwQZqRoTbTdgioTCajZqIVHz.jpg","released":"2026-05-19T12:00:00.000Z","runtime":"37 min"},{"id":"tt33332385:1:6","season":1,"episode":6,"title":"Nuestra historia","overview":"La historia de Widow’s Bay es un bello cuento sobre el matrimonio, la lealtad y el amor que perduran más allá de una vida. Eso es todo.","thumbnail":"https://image.tmdb.org/t/p/w780/76u7aGFKNzkBGELAHeIFczkwg93.jpg","released":"2026-05-26T12:00:00.000Z","runtime":"38 min"},{"id":"tt33332385:1:7","season":1,"episode":7,"title":"Mareo en el mar","overview":"¡Zarpa hacia altamar con el alcalde Loftis y el querido lugareño, Wick! Ellos estarán atendiendo un asunto, así que simplemente disfruta el viaje.","thumbnail":"https://image.tmdb.org/t/p/w780/lOmUL2aEjzmqk5UoZGylPPgPWoH.jpg","released":"2026-05-26T12:00:00.000Z","runtime":"43 min"},{"id":"tt33332385:1:8","season":1,"episode":8,"title":"Tu equipaje","overview":"No te preocupes por el equipaje perdido. Los viejos equipajes resurgen en Widow’s Bay.","thumbnail":"https://image.tmdb.org/t/p/w780/eh3wez62jJ79krAvtgWLRVStUZj.jpg","released":"2026-06-02T12:00:00.000Z","runtime":"34 min"},{"id":"tt33332385:1:9","season":1,"episode":9,"title":"Refugio de emergencia","overview":"Por favor, busca refugio en caso de que una centenaria tormenta azote la isla y nos hunda en la oscuridad. Disfruta de un juego de cartas.","thumbnail":"https://image.tmdb.org/t/p/w780/xp1MLkjLEBK90f782hzeZ8jsBp1.jpg","released":"2026-06-09T12:00:00.000Z","runtime":"32 min"},{"id":"tt33332385:1:10","season":1,"episode":10,"title":"Esperamos que hayas disfrutado tu estancia","overview":"Entendemos que debieron tomarse decisiones difíciles y tal vez jamás volvamos a ser los mismos, ¡pero esperamos que nos visites de nuevo!","thumbnail":"https://image.tmdb.org/t/p/w780/2IBA5wRp0xtYhiAPfgsPA8jLsB2.jpg","released":"2026-06-16T12:00:00.000Z","runtime":"49 min"}]}}