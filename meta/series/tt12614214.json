e.tmdb.org/t/p/w276_and_h350_face/hXjjbYg1Ah8mFf5ZcaakyXzDKMx.jpg","tmdbId":1294982},{"name":"Ken Jeong","character":"Feng","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/dfuDZ2m2A8nBb0TdyeqmlPOobJA.jpg","tmdbId":83586},{"name":"Anna Konkle","character":"Hannah","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/5eXyNxWOESSAdDjVJyrW5SJEDzu.jpg","tmdbId":1489288},{"name":"Poppy Liu","character":"Grace","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/i36QkUChZN7K8BQa1ReaZHes6L4.jpg","tmdbId":2392602},{"name":"Elizabeth Perkins","character":"Isabel","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/t9Cfx8R8hxB1Od46s9CXJMwwNTA.jpg","tmdbId":20},{"name":"Jack Whitehall","character":"Sebastian","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/qBHLpjH3Dad9ZoZsrcMplIPwkHC.jpg","tmdbId":212285},{"name":"Zach Woods","character":"Edgar","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/jolb1uMzDZGTKOKyhgeG3RIsL2W.jpg","tmdbId":464993},{"name":"邬君梅","character":"Vivian","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/9eVO9mefla7stKGH67SAqmHyVya.jpg","tmdbId":69033}],"writers":[{"name":"Christopher Miller","character":"Christopher Miller","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/dr2yCgYtmNmO5vzjk9KNbjTpbzO.jpg","tmdbId":155267}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/qkyggVNng4tTNe6I6TwIwOWSVEi.jpg","https://image.tmdb.org/t/p/w500/wtamFfvduIH34I9jRn9Rr1faE6S.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt12614214:1:1","season":1,"episode":1,"title":"Aniq","overview":"Después de una impactante muerte en el after de una reunión de secundaria, la detective Danner interroga a Aniq, quien narra los hechos como una comedia romántica.","thumbnail":"https://image.tmdb.org/t/p/w780/kUjYPhGqctjjp4oXtPeyBiXeLdq.jpg","released":"2022-01-28T12:00:00.000Z","runtime":"48 min"},{"id":"tt12614214:1:2","season":1,"episode":2,"title":"Brett","overview":"En la historia de acción que es la versión de Brett, él tenía un solo objetivo al asistir a la reunión: reconciliarse con su ex esposa para recuperar a su familia.","thumbnail":"https://image.tmdb.org/t/p/w780/jM3prUos9smTUH0zZQ20XsfwSEt.jpg","released":"2022-01-28T12:00:00.000Z","runtime":"34 min"},{"id":"tt12614214:1:3","season":1,"episode":3,"title":"Yasper","overview":"Yasper explica cómo intentó que Xavier lo ayudara a despegar su carrera musical. Su versión de los hechos es un rítmico musical.","thumbnail":"https://image.tmdb.org/t/p/w780/m6YJQJMuG8a6UoBhFFmLh59BW0L.jpg","released":"2022-01-28T12:00:00.000Z","runtime":"34 min"},{"id":"tt12614214:1:4","season":1,"episode":4,"title":"Chelsea","overview":"Chelsea revela su no tan inocente móvil: venganza, así de sencillo. Su relato resulta ser un thriller psicológico.","thumbnail":"https://image.tmdb.org/t/p/w780/xVwWJF1RClyBp74cDkXKYNHu6Bg.jpg","released":"2022-02-04T12:00:00.000Z","runtime":"33 min"},{"id":"tt12614214:1:5","season":1,"episode":5,"title":"Preparatoria","overview":"Las historias de todos los llevan a una fiesta de hace 15 años, que es relatada por Walt a la Detective Danner, revelando enormes secretos.","thumbnail":"https://image.tmdb.org/t/p/w780/k8tPs8DpqLyC04czW9L9C53urYw.jpg","released":"2022-02-11T12:00:00.000Z","runtime":"36 min"},{"id":"tt12614214:1:6","season":1,"episode":6,"title":"Zoë","overview":"Zoë confiesa que fue a la reunión para tener una noche salvaje, un descanso de su divorcio y su vida de madre soltera. Las cosas se ponen animadas en su historia.","thumbnail":"https://image.tmdb.org/t/p/w780/dQiAEJIXcsBF5p1L3dF7uI52uXF.jpg","released":"2022-02-18T12:00:00.000Z","runtime":"31 min"},{"id":"tt12614214:1:7","season":1,"episode":7,"title":"Danner","overview":"Cuando sus métodos poco convencionales la meten en problemas, la Detective Danner recuerda su propio pasado para explicar por qué necesita resolver este caso.","thumbnail":"https://image.tmdb.org/t/p/w780/1KDese24hl5YVBAEpzBSbUCuBAK.jpg","released":"2022-02-25T12:00:00.000Z","runtime":"33 min"},{"id":"tt12614214:1:8","season":1,"episode":8,"title":"Maggie","overview":"Un testigo inesperado aparece para ayudar a la Detective Danner a descifrar la verdadera historia tras la muerte de Xavier.","thumbnail":"https://image.tmdb.org/t/p/w780/mzPEK3W2KABWSTzSWsh9rgH0vU1.jpg","released":"2022-03-04T12:00:00.000Z","runtime":"35 min"},{"id":"tt12614214:2:1","season":2,"episode":1,"title":"Aniq 2: La secuela","overview":"Cuando la boda de la hermana de Zoë es destruida por un homicidio, Aniq llama a su vieja amiga Danner para investigar el crimen.","thumbnail":"https://image.tmdb.org/t/p/w780/f2h1K0G7IkREydO9z6d1FTjijtH.jpg","released":"2023-07-11T12:00:00.000Z","runtime":"44 min"},{"id":"tt12614214:2:2","season":2,"episode":2,"title":"Grace","overview":"Aniq y Danner entrevistan a la novia, quien les cuenta la historia de su relación con Edgar al estilo romántico de Jane Austen.","thumbnail":"https://image.tmdb.org/t/p/w780/66EWkqvXXO80vnjomuPlTbLSUTk.jpg","released":"2023-07-11T12:00:00.000Z","runtime":"37 min"},{"id":"tt12614214:2:3","season":2,"episode":3,"title":"Travis","overview":"El ex novio de Grace cuenta su historia como una película de cine negro: Él sospechaba que Edgar tramaba algo malo y estaba determinado a proteger a su ex.","thumbnail":"https://image.tmdb.org/t/p/w780/3XRkWMS0ib6AGNrqkNqfCLcvEoQ.jpg","released":"2023-07-18T12:00:00.000Z","runtime":"34 min"},{"id":"tt12614214:2:4","season":2,"episode":4,"title":"Hannah","overview":"Como heroína de una película independiente, la hermana adoptiva de Edgar quería detener la boda por su corazón roto.","thumbnail":"https://image.tmdb.org/t/p/w780/x8VHQADKsMuhn84cmoiiJWvCMr4.jpg","released":"2023-07-25T12:00:00.000Z","runtime":"31 min"},{"id":"tt12614214:2:5","season":2,"episode":5,"title":"Sebastian","overview":"El socio de negocios de Edgar cuenta su complicada historia como una hábil película de robos.","thumbnail":"https://image.tmdb.org/t/p/w780/w92pFDB22tHMiYAJl672i0rUKss.jpg","released":"2023-08-01T12:00:00.000Z","runtime":"34 min"},{"id":"tt12614214:2:6","season":2,"episode":6,"title":"El fuego de Danner","overview":"¿Por qué Danner dejó las fuerzas policiacas? Ella cuenta a Amiq esta centelleante historia como un caliente thriller de los noventa.","thumbnail":"https://image.tmdb.org/t/p/w780/rKCZVyD3RDGuCl9NfMt7K9hwCdd.jpg","released":"2023-08-08T12:00:00.000Z","runtime":"34 min"},{"id":"tt12614214:2:7","season":2,"episode":7,"title":"Ulises","overview":"Aniq y Danner dirigen la investigación hacia la familia de Zoë, comenzando con el tío de espíritu libre. Su historia es un romance épico.","thumbnail":"https://image.tmdb.org/t/p/w780/hzT2o0vGR3kdxHMtk4UUG1CPYIC.jpg","released":"2023-08-15T12:00:00.000Z","runtime":"38 min"},{"id":"tt12614214:2:8","season":2,"episode":8,"title":"Feng","overview":"El padre de Zoë accede de mala gana a sentarse con ella, Aniq y Danner para revisar los videos caseros del fin de semana.","thumbnail":"https://image.tmdb.org/t/p/w780/fap2KQOB6qDfIPQzwUiSYeRGLEw.jpg","released":"2023-08-22T12:00:00.000Z","runtime":"34 min"},{"id":"tt12614214:2:9","season":2,"episode":9,"title":"Isabel","overview":"Al estilo de un drama psicológico de los 50, la madre de Edgar detalla su catastrófico año desde la muerte de su esposo.","thumbnail":"https://image.tmdb.org/t/p/w780/zjjZIEqFeysP4VHgKVUXCi05zlP.jpg","released":"2023-08-29T12:00:00.000Z","runtime":"35 min"},{"id":"tt12614214:2:10","season":2,"episode":10,"title":"Vivian y Zoë","overview":"Alternando entre el cine de serie B y una telenovela de los 80, Zoë y su madre llenan los vacíos que quedan en el homicidio de Edgar.","thumbnail":"https://image.tmdb.org/t/p/w780/krUyKNgVJlJL78kf6WAvDQbPpp6.jpg","released":"2023-09-05T12:00:00.000Z","runtime":"31 min"}]}}