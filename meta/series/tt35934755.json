rg/t/p/w780/7NPEWtVHa0YqdFL8rFt75RKZQm1.jpg","released":"2026-10-08T12:00:00.000Z","runtime":"39 min"},{"id":"tt35934755:1:5","season":1,"episode":5,"title":"Little Pot Rock","overview":"Calvin descubre una verdad perturbadora sobre su pasado. Fonda encuentra algo desconcertante, y llega una visita inesperada.","thumbnail":"https://image.tmdb.org/t/p/w780/7eoSmnHUiEkConnsbimZPbfhGba.jpg","released":"2026-10-08T12:00:00.000Z","runtime":"41 min"},{"id":"tt35934755:1:6","season":1,"episode":6,"title":"Las profundidades de no ser padre","overview":"Cuando se revelan los verdaderos motivos detrás de la crisis y empieza la evacuación, Calvin, su familia y Fonda idean un arriesgado plan para salvar al pueblo.","thumbnail":"https://image.tmdb.org/t/p/w780/hTwvypom5WQB6yKO9DbJkz2rs0N.jpg","released":"2026-10-08T12:00:00.000Z","runtime":"37 min"}]}}