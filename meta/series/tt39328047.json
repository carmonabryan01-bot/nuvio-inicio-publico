face/7d88xPM0traynfzvpqXo93SkYyP.jpg","tmdbId":3207964},{"name":"김종구","character":"Kim Myeong-seop","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/t5CnFB7boQEoNofUmch5wcUn2w3.jpg","tmdbId":1171953},{"name":"장승조","character":"Na Dae-il","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/3HWGHh4Zazo4rEjQNz1B7KEJ9Cd.jpg","tmdbId":1487428},{"name":"Kim Hak-Soo","character":"Professor Hwang","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/yKWBfPkDOHRgmlAwbdq2BRiuWxj.jpg","tmdbId":5730673},{"name":"Jang Myung-jin","character":"Police","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/5wCvmFqBjzKD2VNoaWTHPp4u91d.jpg","tmdbId":2453131}],"directors":[{"name":"이정림","photo":"https://image.tmdb.org/t/p/w276_and_h350_face/vECGxw0lUSviNUqEiiuNHIhg3rZ.jpg","tmdbId":3722125}],"writers":[{"name":"편성근","character":"편성근","photo":null,"tmdbId":6509738}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/9zMjvgGPokNYCYhSgMGCRQetMmC.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt39328047:1:1","season":1,"episode":1,"title":"Episodio 1","overview":"En su primer día en el hospital, Gye Su-jeong envuelve rápidamente las plumas cuando sopesa sobre una próxima cirugía, solo para saltar cuando surge una crisis.","thumbnail":"https://image.tmdb.org/t/p/w780/3SBnUDLb5Uwds7iWUcGurVdRbwb.jpg","released":"2026-10-09T12:00:00.000Z","runtime":"66 min"},{"id":"tt39328047:1:2","season":1,"episode":2,"title":"Episodio 2","overview":"Ante dos pacientes con cáncer de páncreas -un presidente adinerado y un adolescente- el personal del hospital choca sobre a quién priorizar. Pero Su-jeong no pierde el tiempo.","thumbnail":"https://image.tmdb.org/t/p/w780/9rLahEmO8kFUzHb5dVyEGtDbsqh.jpg","released":"2026-10-10T12:00:00.000Z","runtime":"64 min"},{"id":"tt39328047:1:3","season":1,"episode":3,"title":"Episodio 3","overview":"El personal del hospital se hace más sospechoso del pasado de Su-jeong. Cuando un limpiador se derrumba repentinamente, Su-jeong debe tomar una decisión ya que no hay cirujano disponible.","thumbnail":"https://image.tmdb.org/t/p/w780/hLK8IvLmYDUI4Tt8xQK30N21Tl5.jpg","released":"2026-10-16T12:00:00.000Z","runtime":"63 min"},{"id":"tt39328047:1:4","season":1,"episode":4,"title":"Episodio 4","overview":"Después de que un nuevo cirujano llega al hospital, Jang Hui-suk y Su-jeong lo vigilan de cerca. En tanto, un representante farmacéutico sufre una emergencia.","thumbnail":"https://image.tmdb.org/t/p/w780/vCNYcpaJHHrEKTCtRtpRjlkBNRq.jpg","released":"2026-10-17T12:00:00.000Z","runtime":"61 min"},{"id":"tt39328047:1:5","season":1,"episode":5,"title":"Episodio 5","overview":"Su-jeong makes a disturbing discovery about Na Dae-il and a patient. As her colleagues debate their next move, she gets a chance to make him pay.","thumbnail":"https://image.tmdb.org/t/p/w780/5G13IhiXd5Lc7R4h9PghV41q3oh.jpg","released":"2026-10-23T12:00:00.000Z","runtime":"64 min"},{"id":"tt39328047:1:6","season":1,"episode":6,"title":"Episodio 6","overview":"A patient struggling with trauma from an old brain injury refuses surgery, pushing Su-jeong and her team to convince him to undergo treatment.","thumbnail":"https://image.tmdb.org/t/p/w780/r836vmrabCtAK6edlvjOnH1JRhX.jpg","released":"2026-10-24T12:00:00.000Z","runtime":"61 min"},{"id":"tt39328047:1:7","season":1,"episode":7,"title":"Episodio 7","overview":"Su-jeong remains determined to save her patient, but a sudden disappearance complicates matters. A VIP code-blue crisis hits the hospital.","thumbnail":"https://image.tmdb.org/t/p/w780/sS8bCGYzC0qKGOiDqHXXbadAPLz.jpg","released":"2026-10-30T12:00:00.000Z","runtime":"62 min"},{"id":"tt39328047:1:8","season":1,"episode":8,"title":"Episodio 8","overview":"A young patient with an extreme diagnosis catches Su-jeong's attention. Hospital director Bu Seung-gwon remains doubtful of Su-jeong's true identity.","thumbnail":"https://image.tmdb.org/t/p/w780/r35eEyEA9sfI0AsWiOq6kRMAEEf.jpg","released":"2026-10-31T12:00:00.000Z","runtime":"64 min"},{"id":"tt39328047:1:9","season":1,"episode":9,"title":"Episodio 9","released":"2026-11-06T12:00:00.000Z"},{"id":"tt39328047:1:10","season":1,"episode":10,"title":"Episodio 10","released":"2026-11-07T12:00:00.000Z"},{"id":"tt39328047:1:11","season":1,"episode":11,"title":"Episodio 11","released":"2026-11-13T12:00:00.000Z"},{"id":"tt39328047:1:12","season":1,"episode":12,"title":"Episodio 12","released":"2026-11-14T12:00:00.000Z"}]}}