l,"tmdbId":5624355},{"name":"Aaron Lam","character":"Aaron Lam","photo":null,"tmdbId":1257453},{"name":"Blaize Ali-Watkins","character":"Blaize Ali-Watkins","photo":null,"tmdbId":5059742}],"certification":"TV-MA","seasonPosters":["https://image.tmdb.org/t/p/w500/zb3zxvbdUYrP0SS7Fl4cXnJ3yJK.jpg"]},"behaviorHints":{"hasScheduledVideos":true},"videos":[{"id":"tt26672404:1:1","season":1,"episode":1,"title":"Pilot","overview":"David Jung, a Korean-American man who faked his death nine years ago, confronts his past when his daughter Rebecca, now working as an assassin for the private intelligence agency Caddis, is sent to kill him.","thumbnail":"https://image.tmdb.org/t/p/w780/xaRipU8rMQSyqV9rpDS1ea9eGCf.jpg","released":"2025-08-13T12:00:00.000Z","runtime":"51 min"},{"id":"tt26672404:1:2","season":1,"episode":2,"title":"Daegu","overview":"David and Rebecca find themselves on the run from Caddis after a tense encounter at a police checkpoint. But their unexpected reunion is complicated by Rebecca's resentment over her father's abandonment.","thumbnail":"https://image.tmdb.org/t/p/w780/33SNddUORsh3Exzr5ce4kySQpEn.jpg","released":"2025-08-13T12:00:00.000Z","runtime":"49 min"},{"id":"tt26672404:1:3","season":1,"episode":3,"title":"Busan","overview":"Rebecca, David and his family escape to a safe house in the coastal city of Busan. Family tensions mount as Rebecca struggles with her father's new family. And a shocking revelation about David's past with Juno is revealed during a violent confrontation at a marina.","thumbnail":"https://image.tmdb.org/t/p/w780/3RCFL9ZVEhuOgA6TFmMFpxHuYun.jpg","released":"2025-08-13T12:00:00.000Z","runtime":"52 min"},{"id":"tt26672404:1:4","season":1,"episode":4,"title":"Pohang","overview":"After abducting Oliver, David and Rebecca use the information they gather from him to devise a plan to go after Juno, taking them back to Seoul, where Gun and Caddis are waiting.","thumbnail":"https://image.tmdb.org/t/p/w780/fdCN2YmZwAphzXJ6RHDbRe4dmYH.jpg","released":"2025-08-13T12:00:00.000Z","runtime":"45 min"},{"id":"tt26672404:1:5","season":1,"episode":5,"title":"Seoul","overview":"Juno interrogates Oliver and discovers he betrayed her while being held captive by David. Meanwhile, David and Rebecca carry out a PSYOP campaign against Juno, aimed at dividing her and Oliver and bringing down Caddis once and for all.","thumbnail":"https://image.tmdb.org/t/p/w780/uVnX0erLUCgVcbKjyEuiP48i2ny.jpg","released":"2025-08-13T12:00:00.000Z","runtime":"49 min"},{"id":"tt26672404:1:6","season":1,"episode":6,"title":"Annyeong","overview":"David pursues Rebecca after she's captured by Juno and Caddis operatives, leading to a high-speed chase and brutal ambush at an abandoned factory site.","thumbnail":"https://image.tmdb.org/t/p/w780/5wR23XiJu0NvOzY6OMx9mrW7sGj.jpg","released":"2025-08-13T12:00:00.000Z","runtime":"49 min"}]}}